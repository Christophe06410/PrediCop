<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrediCop.Mobile.Views.AppHeader">

    <Grid RowDefinitions="*,2" BackgroundColor="#0d1421">

        <!-- Contenu principal du header -->
        <Grid Grid.Row="0" Padding="16,10,20,10"
              ColumnDefinitions="Auto,*,Auto">

            <!-- Icône logo dans un badge arrondi -->
            <Border Grid.Column="0"
                    BackgroundColor="#1e3a70"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    WidthRequest="44" HeightRequest="44"
                    Margin="0,0,14,0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11"/>
                </Border.StrokeShape>
                <Image Source="logo_pm.png"
                       HeightRequest="34" WidthRequest="34"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Nom + sous-titre -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="PREDICOP"
                       TextColor="White"
                       FontSize="17" FontAttributes="Bold"
                       CharacterSpacing="2"/>
                <Label Text="Police Municipale"
                       TextColor="#4b6080"
                       FontSize="10"
                       CharacterSpacing="0.5"/>
            </VerticalStackLayout>

            <!-- Indicateur de connexion -->
            <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="5">
                <Ellipse Fill="#22c55e"
                         WidthRequest="7" HeightRequest="7"
                         VerticalOptions="Center"/>
                <Label Text="EN LIGNE"
                       TextColor="#22c55e"
                       FontSize="9" FontAttributes="Bold"
                       CharacterSpacing="0.5"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

        </Grid>

        <!-- Ligne accent bleue en bas -->
        <BoxView Grid.Row="1" BackgroundColor="#2563eb" Opacity="0.7"/>

    </Grid>

</ContentView>
