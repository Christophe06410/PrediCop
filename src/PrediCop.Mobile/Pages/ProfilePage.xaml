<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PrediCop.Mobile.Views"
             x:Class="PrediCop.Mobile.Pages.ProfilePage"
             BackgroundColor="#1a2035">

    <Grid RowDefinitions="Auto,*">
    <views:AppHeader Grid.Row="0"/>
    <ScrollView Grid.Row="1">
    <VerticalStackLayout Padding="24" Spacing="20">

        <Border BackgroundColor="#243050" Padding="20">
            <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="Mon Profil"
                       FontSize="18" FontAttributes="Bold" TextColor="White"/>
                <Label Text="{Binding UserName}" TextColor="#93c5fd" FontSize="16"/>
                <Label Text="{Binding Badge}" TextColor="#6b7a99" FontSize="13"/>
            </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="#243050" Padding="20">
            <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="Véhicule de service"
                       FontSize="16" FontAttributes="Bold" TextColor="White"/>
                <Label Text="{Binding CurrentVehicle}" TextColor="#93c5fd" FontSize="14"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0"
                            Text="Sélectionner mon véhicule"
                            BackgroundColor="#2563eb" TextColor="White"
                            CornerRadius="10" HeightRequest="44"
                            IsEnabled="{Binding IsLoadingVehicles, Converter={StaticResource InvertBoolConverter}}"
                            Clicked="OnSelectVehicleClicked"/>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsLoadingVehicles}"
                                       IsVisible="{Binding IsLoadingVehicles}"
                                       Color="#2563eb"
                                       WidthRequest="36" HeightRequest="36"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center"/>
                </Grid>
                <Button x:Name="BtnDetectVehicle"
                        Text="Détecter mon véhicule (BLE)"
                        BackgroundColor="#0f766e" TextColor="White"
                        CornerRadius="10" HeightRequest="44"
                        Clicked="OnDetectVehicleClicked"/>
                <Button Text="Quitter la patrouille"
                        BackgroundColor="#991b1b" TextColor="White"
                        CornerRadius="10" HeightRequest="44"
                        IsVisible="{Binding IsInPatrol}"
                        Clicked="OnLeavePatrolClicked"/>
                <Button Text="Configurer les beacons"
                        BackgroundColor="#1e3a5f" TextColor="White"
                        CornerRadius="10" HeightRequest="44"
                        IsVisible="{Binding IsAdminOrManager}"
                        Clicked="OnBeaconPairingClicked"/>
            </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="#243050" Padding="20">
            <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="Paramètres"
                       FontSize="16" FontAttributes="Bold" TextColor="White"/>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Son d'alerte mission" TextColor="#aab0c0"/>
                        <Label Text="Sonnerie + vibration à la réception d'une mission"
                               TextColor="#6b7a99" FontSize="11"/>
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AlertSoundEnabled, Mode=TwoWay}"
                            OnColor="#2563eb"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Suivi GPS actif" TextColor="#aab0c0"
                           VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="True"
                            OnColor="#2563eb" Toggled="OnGpsToggled"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Button Text="Changer mon mot de passe" BackgroundColor="#1e3a5f" TextColor="White"
                CornerRadius="12" HeightRequest="50" Clicked="OnChangePasswordClicked"/>

        <Border BackgroundColor="#243050" Padding="20">
            <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="Fin de service"
                       FontSize="16" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Générez et signez votre rapport de vacation."
                       TextColor="#6b7a99" FontSize="13"/>
                <Button Text="Rapport de vacation"
                        BackgroundColor="#2563eb" TextColor="White"
                        CornerRadius="10" HeightRequest="44"
                        Clicked="OnShiftReportClicked"/>
            </VerticalStackLayout>
        </Border>

        <Button Text="Se déconnecter" BackgroundColor="#374151" TextColor="White"
                CornerRadius="12" HeightRequest="50" Clicked="OnLogoutClicked"/>
    </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
