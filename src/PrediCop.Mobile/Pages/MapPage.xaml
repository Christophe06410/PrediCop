<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PrediCop.Mobile.Views"
             x:Class="PrediCop.Mobile.Pages.MapPage"
             BackgroundColor="#1a2035">

    <Grid RowDefinitions="Auto,*">
        <views:AppHeader Grid.Row="0"/>

        <WebView Grid.Row="1" x:Name="MapWebView"
                 BackgroundColor="Transparent"/>

        <!-- Visible uniquement quand un point est focalisé (depuis patrouille) -->
        <Button x:Name="DirectionsButton"
                Grid.Row="1"
                IsVisible="False"
                Text="Itineraire GPS"
                BackgroundColor="#2563eb"
                TextColor="White"
                CornerRadius="24"
                Padding="20,10"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,24"
                Clicked="OnDirectionsClicked"/>
    </Grid>
</ContentPage>
