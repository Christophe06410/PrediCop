<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PrediCop.Core\PrediCop.Core.csproj" />
    <ProjectReference Include="..\PrediCop.Infrastructure\PrediCop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0-preview.4.25258.110" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Installe toutes les dépendances npm et copie les assets dans wwwroot/lib/ -->
  <Target Name="InstallFrontendDeps" BeforeTargets="Build"
          Inputs="package.json"
          Outputs="wwwroot\lib\tinymce\tinymce.min.js;wwwroot\lib\fontawesome\css\all.min.css;wwwroot\lib\leaflet\leaflet.js;wwwroot\lib\chartjs\chart.umd.js;wwwroot\lib\signalr\signalr.min.js">
    <Message Text="npm install (frontend deps)..." Importance="high" />
    <Exec Command="npm install --prefer-offline" WorkingDirectory="$(ProjectDir)" />

    <!-- TinyMCE -->
    <ItemGroup>
      <TinyMCEFiles Include="$(ProjectDir)node_modules\tinymce\**\*.*" />
      <TinyMCELangs Include="$(ProjectDir)node_modules\tinymce-i18n\langs7\fr_FR.js" />
    </ItemGroup>
    <Copy SourceFiles="@(TinyMCEFiles)"
          DestinationFiles="@(TinyMCEFiles->'$(ProjectDir)wwwroot\lib\tinymce\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TinyMCELangs)"
          DestinationFolder="$(ProjectDir)wwwroot\lib\tinymce\langs\"
          SkipUnchangedFiles="true" />

    <!-- Font Awesome -->
    <ItemGroup>
      <FAFiles Include="$(ProjectDir)node_modules\@fortawesome\fontawesome-free\css\all.min.css" />
      <FAFiles Include="$(ProjectDir)node_modules\@fortawesome\fontawesome-free\webfonts\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="$(ProjectDir)node_modules\@fortawesome\fontawesome-free\css\all.min.css"
          DestinationFolder="$(ProjectDir)wwwroot\lib\fontawesome\css\"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FAWebfonts Include="$(ProjectDir)node_modules\@fortawesome\fontawesome-free\webfonts\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FAWebfonts)"
          DestinationFolder="$(ProjectDir)wwwroot\lib\fontawesome\webfonts\"
          SkipUnchangedFiles="true" />

    <!-- Leaflet -->
    <Copy SourceFiles="$(ProjectDir)node_modules\leaflet\dist\leaflet.css"
          DestinationFolder="$(ProjectDir)wwwroot\lib\leaflet\"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)node_modules\leaflet\dist\leaflet.js"
          DestinationFolder="$(ProjectDir)wwwroot\lib\leaflet\"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <LeafletImages Include="$(ProjectDir)node_modules\leaflet\dist\images\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LeafletImages)"
          DestinationFolder="$(ProjectDir)wwwroot\lib\leaflet\images\"
          SkipUnchangedFiles="true" />

    <!-- Chart.js -->
    <Copy SourceFiles="$(ProjectDir)node_modules\chart.js\dist\chart.umd.js"
          DestinationFolder="$(ProjectDir)wwwroot\lib\chartjs\"
          SkipUnchangedFiles="true" />

    <!-- SignalR JS client -->
    <Copy SourceFiles="$(ProjectDir)node_modules\@microsoft\signalr\dist\browser\signalr.min.js"
          DestinationFolder="$(ProjectDir)wwwroot\lib\signalr\"
          SkipUnchangedFiles="true" />

    <Message Text="Dépendances frontend copiées dans wwwroot/lib/" Importance="high" />
  </Target>

</Project>
