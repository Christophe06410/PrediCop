@page
@model PrediCop.BackOffice.Pages.Dashboard.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Manager";
    var d = Model.Dashboard;
    var ts = Model.TimeSeriesStats;
    var hoursJson = JsonSerializer.Serialize(d.MissionsByHour.Select(h => h.Hour + "h"));
    var countsJson = JsonSerializer.Serialize(d.MissionsByHour.Select(h => h.Count));
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-gauge me-2 text-primary"></i>Dashboard Manager
    </h4>
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small">
            <i class="fa-regular fa-clock me-1"></i>@DateTime.Now.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR")) — @DateTime.Now.ToString("HH:mm")
        </span>
        <a asp-page="/Dashboard/Export" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-file-export me-1"></i>Exporter
        </a>
    </div>
</div>

<!-- Filtre de période -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="Days" value="@Model.Days" />
            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">
                    <i class="fa-solid fa-calendar-day me-1 text-secondary"></i>Début
                </label>
                <input type="datetime-local" name="DateFrom" class="form-control form-control-sm"
                       value="@Model.DateFromInput" />
            </div>
            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">
                    <i class="fa-solid fa-calendar-check me-1 text-secondary"></i>Fin
                </label>
                <input type="datetime-local" name="DateTo" class="form-control form-control-sm"
                       value="@Model.DateToInput" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-filter me-1"></i>Appliquer
                </button>
                <a asp-page="/Dashboard/Index" asp-route-Days="@Model.Days"
                   class="btn btn-outline-secondary btn-sm ms-1"
                   title="Réinitialiser à aujourd'hui">
                    <i class="fa-solid fa-rotate-left me-1"></i>Aujourd'hui
                </a>
            </div>
            <div class="col-auto text-muted small align-self-center">
                <i class="fa-solid fa-circle-info me-1"></i>
                Appels &amp; missions : @((Model.DateFrom ?? DateTime.Today).ToString("dd/MM HH:mm")) – @((Model.DateTo ?? DateTime.Now).ToString("dd/MM HH:mm"))
            </div>
        </form>
    </div>
</div>

<!-- Onglets dashboard -->
<ul class="nav nav-tabs mb-0" id="dashboardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-overview-btn" data-bs-toggle="tab"
                data-bs-target="#tab-overview" type="button" role="tab">
            <i class="fa-solid fa-gauge me-1"></i>Vue d'ensemble
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-evolution-btn" data-bs-toggle="tab"
                data-bs-target="#tab-evolution" type="button" role="tab">
            <i class="fa-solid fa-chart-line me-1"></i>Évolution
            <span class="badge bg-primary ms-1" id="tab-days-badge">@Model.Days j</span>
        </button>
    </li>
</ul>
<div class="tab-content border border-top-0 rounded-bottom p-0 mb-4">

<div class="tab-pane fade show active p-3" id="tab-overview">

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm kpi-card border-start border-4 border-primary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Mains courantes (période)</div>
                    <div class="kpi-value text-primary">@d.CallsToday</div>
                </div>
                <div class="kpi-icon text-primary">
                    <i class="fa-solid fa-phone"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm kpi-card border-start border-4 border-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Missions actives</div>
                    <div class="kpi-value text-success">@d.ActiveMissions</div>
                </div>
                <div class="kpi-icon text-success">
                    <i class="fa-solid fa-car-side"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm kpi-card border-start border-4 border-info">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Véhicules disponibles</div>
                    <div class="kpi-value text-info">@d.AvailableVehicles</div>
                </div>
                <div class="kpi-icon text-info">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm kpi-card border-start border-4 border-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Véhicules en mission</div>
                    <div class="kpi-value text-warning">@d.VehiclesOnMission</div>
                </div>
                <div class="kpi-icon text-warning">
                    <i class="fa-solid fa-location-crosshairs"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.HasQualificationAlert)
{
    <div class="alert alert-warning d-flex align-items-start gap-3 mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-id-card fa-lg mt-1 text-warning flex-shrink-0"></i>
        <div class="flex-grow-1">
            <div class="fw-semibold mb-1">Habilitations agents à traiter</div>
            <div class="d-flex flex-wrap gap-3">
                @if (Model.ExpiredQualificationsCount > 0)
                {
                    <span class="badge bg-danger fs-6 fw-normal px-3 py-2">
                        <i class="fa-solid fa-circle-xmark me-1"></i>
                        @Model.ExpiredQualificationsCount expirée(s)
                    </span>
                }
                @if (Model.ExpiringQualificationsCount > 0)
                {
                    <span class="badge bg-warning text-dark fs-6 fw-normal px-3 py-2">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        @Model.ExpiringQualificationsCount expire(nt) dans 30 jours
                    </span>
                }
            </div>
        </div>
        <a asp-page="/Admin/Qualifications/Index" class="btn btn-sm btn-outline-warning flex-shrink-0">
            <i class="fa-solid fa-arrow-right me-1"></i>Gérer
        </a>
    </div>
}

@if (Model.HasFleetAlert)
{
    <div class="alert alert-danger d-flex align-items-start gap-3 mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-screwdriver-wrench fa-lg mt-1 text-danger flex-shrink-0"></i>
        <div class="flex-grow-1">
            <div class="fw-semibold mb-1">Entretiens véhicules à traiter</div>
            <div class="d-flex flex-wrap gap-3">
                @if (Model.FleetOverdueCount > 0)
                {
                    <span class="badge bg-danger fs-6 fw-normal px-3 py-2">
                        <i class="fa-solid fa-circle-xmark me-1"></i>
                        @Model.FleetOverdueCount en retard
                    </span>
                }
                @if (Model.FleetUpcomingCount > 0)
                {
                    <span class="badge bg-warning text-dark fs-6 fw-normal px-3 py-2">
                        <i class="fa-solid fa-calendar-exclamation me-1"></i>
                        @Model.FleetUpcomingCount à planifier dans 30 jours
                    </span>
                }
            </div>
        </div>
        <a asp-page="/Admin/Fleet/Index" class="btn btn-sm btn-outline-danger flex-shrink-0">
            <i class="fa-solid fa-arrow-right me-1"></i>Gérer
        </a>
    </div>
}

<div class="row g-3 mb-4">
    <!-- Graphique missions par heure -->
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-chart-bar me-2 text-primary"></i>Missions par heure <small class="text-muted fw-normal">— sur la période sélectionnée</small>
                </h6>
            </div>
            <div class="card-body">
                <canvas id="missionsChart" style="max-height:280px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Top véhicules -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-trophy me-2 text-warning"></i>Top 5 véhicules
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Indicatif</th>
                                <th class="text-success text-center">Acceptées</th>
                                <th class="text-danger text-center">Refusées</th>
                                <th class="text-center">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var v in d.TopVehicles)
                            {
                                var rankIcon = rank switch { 1 => "text-warning", 2 => "text-secondary", 3 => "text-danger", _ => "text-muted" };
                                <tr>
                                    <td><i class="fa-solid fa-medal @rankIcon"></i></td>
                                    <td class="fw-semibold">
                                        @if (v.VehicleId.HasValue)
                                        {
                                            <a asp-page="/Admin/Vehicles/Edit" asp-route-id="@v.VehicleId" class="text-decoration-none fw-semibold">@v.CallSign</a>
                                        }
                                        else
                                        {
                                            @v.CallSign
                                        }
                                    </td>
                                    <td class="text-center text-success fw-bold">@v.AcceptedCount</td>
                                    <td class="text-center text-danger">@v.RefusedCount</td>
                                    <td class="text-center">
                                        <div class="progress" style="height:6px;">
                                            <div class="progress-bar bg-success" style="width:@(v.TotalCount > 0 ? (v.AcceptedCount * 100 / v.TotalCount) : 0)%"></div>
                                            <div class="progress-bar bg-danger" style="width:@(v.TotalCount > 0 ? (v.RefusedCount * 100 / v.TotalCount) : 0)%"></div>
                                        </div>
                                        <small class="text-muted">@v.TotalCount</small>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 10 dernières missions -->
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold">
            <i class="fa-solid fa-list me-2 text-secondary"></i>10 dernières missions
        </h6>
        <a asp-page="/Missions/Index" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-external-link-alt me-1"></i>Toutes les missions
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Référence</th>
                        <th>Statut</th>
                        <th>Adresse</th>
                        <th>Véhicule</th>
                        <th>Créée</th>
                        <th>Terminée</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in d.RecentMissions)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-page="/Missions/Details" asp-route-id="@m.Id" class="text-decoration-none fw-semibold">@m.Reference</a>
                            </td>
                            <td>
                                @await Html.PartialAsync("_StatusBadge", (object)m.Status)
                            </td>
                            <td>@m.TargetAddress</td>
                            <td>
                                @if (!string.IsNullOrEmpty(m.AssignedVehicleCallSign) && m.AssignedVehicleId.HasValue)
                                {
                                    <a asp-page="/Admin/Vehicles/Edit" asp-route-id="@m.AssignedVehicleId" class="text-decoration-none">@m.AssignedVehicleCallSign</a>
                                }
                                else
                                {
                                    @(m.AssignedVehicleCallSign ?? "—")
                                }
                            </td>
                            <td>@m.CreatedAt.ToLocalTime().ToString("HH:mm")</td>
                            <td>@(m.CompletedAt?.ToLocalTime().ToString("HH:mm") ?? "—")</td>
                            <td>
                                <a asp-page="/Missions/Details" asp-route-id="@m.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

</div><!-- end tab-overview -->

<div class="tab-pane fade p-3" id="tab-evolution">
<!-- ===================== ÉVOLUTION TEMPORELLE ===================== -->
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h6 class="mb-0 fw-semibold">
            <i class="fa-solid fa-chart-line me-2 text-primary"></i>Évolution sur <span id="ts-days-label">@Model.Days</span> jours
            <small class="text-muted fw-normal ms-2" id="ts-period-label">(@ts.CurrentPeriod.PeriodLabel)</small>
        </h6>
        <!-- Sélecteur de période -->
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="ts-btn btn @(Model.Days == 7 ? "btn-primary" : "btn-outline-primary")"
                    data-days="7" onclick="loadTimeSeries(7)">7j</button>
            <button type="button" class="ts-btn btn @(Model.Days == 14 ? "btn-primary" : "btn-outline-primary")"
                    data-days="14" onclick="loadTimeSeries(14)">14j</button>
            <button type="button" class="ts-btn btn @(Model.Days == 30 ? "btn-primary" : "btn-outline-primary")"
                    data-days="30" onclick="loadTimeSeries(30)">30j</button>
        </div>
    </div>
    <div class="card-body" id="ts-body">
        <!-- Cartes de comparaison -->
        <div class="row g-3 mb-4">
            <!-- Appels -->
            <div class="col-md-4">
                <div class="card border h-100">
                    <div class="card-body text-center">
                        <div class="text-muted small fw-semibold text-uppercase mb-1">
                            <i class="fa-solid fa-phone me-1"></i>Appels
                        </div>
                        <div class="fs-2 fw-bold text-primary">@ts.CurrentPeriod.TotalCalls</div>
                        <div class="text-muted small">vs @ts.PreviousPeriod.TotalCalls période précédente</div>
                        @if (ts.CurrentPeriod.CallsDeltaPercent.HasValue)
                        {
                            var delta = ts.CurrentPeriod.CallsDeltaPercent.Value;
                            @if (delta > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger mt-1">
                                    <i class="fa-solid fa-arrow-up me-1"></i>@delta.ToString("F1")%
                                </span>
                            }
                            else if (delta < 0)
                            {
                                <span class="badge bg-success-subtle text-success mt-1">
                                    <i class="fa-solid fa-arrow-down me-1"></i>@Math.Abs(delta).ToString("F1")%
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary mt-1">= stable</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary mt-1">nouveau</span>
                        }
                    </div>
                </div>
            </div>
            <!-- Missions complétées -->
            <div class="col-md-4">
                <div class="card border h-100">
                    <div class="card-body text-center">
                        <div class="text-muted small fw-semibold text-uppercase mb-1">
                            <i class="fa-solid fa-flag-checkered me-1"></i>Missions complétées
                        </div>
                        <div class="fs-2 fw-bold text-success">@ts.CurrentPeriod.CompletedMissions</div>
                        <div class="text-muted small">vs @ts.PreviousPeriod.CompletedMissions période précédente</div>
                        @if (ts.CurrentPeriod.MissionsDeltaPercent.HasValue)
                        {
                            var delta = ts.CurrentPeriod.MissionsDeltaPercent.Value;
                            @if (delta > 0)
                            {
                                <span class="badge bg-success-subtle text-success mt-1">
                                    <i class="fa-solid fa-arrow-up me-1"></i>@delta.ToString("F1")%
                                </span>
                            }
                            else if (delta < 0)
                            {
                                <span class="badge bg-danger-subtle text-danger mt-1">
                                    <i class="fa-solid fa-arrow-down me-1"></i>@Math.Abs(delta).ToString("F1")%
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary mt-1">= stable</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary mt-1">nouveau</span>
                        }
                    </div>
                </div>
            </div>
            <!-- Temps de réponse moyen -->
            <div class="col-md-4">
                <div class="card border h-100">
                    <div class="card-body text-center">
                        <div class="text-muted small fw-semibold text-uppercase mb-1">
                            <i class="fa-solid fa-stopwatch me-1"></i>Temps de réponse moyen
                        </div>
                        <div class="fs-2 fw-bold text-info">@ts.CurrentPeriod.AverageResponseTimeMinutes.ToString("F1") min</div>
                        <div class="text-muted small">vs @ts.PreviousPeriod.AverageResponseTimeMinutes.ToString("F1") min période préc.</div>
                        @if (ts.CurrentPeriod.ResponseTimeDeltaPercent.HasValue)
                        {
                            var delta = ts.CurrentPeriod.ResponseTimeDeltaPercent.Value;
                            @if (delta > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger mt-1">
                                    <i class="fa-solid fa-arrow-up me-1"></i>@delta.ToString("F1")%
                                </span>
                            }
                            else if (delta < 0)
                            {
                                <span class="badge bg-success-subtle text-success mt-1">
                                    <i class="fa-solid fa-arrow-down me-1"></i>@Math.Abs(delta).ToString("F1")%
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary mt-1">= stable</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary mt-1">nouveau</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau des jours -->
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th class="text-center">Appels</th>
                        <th class="text-center">Missions</th>
                        <th class="text-center">Complétées</th>
                        <th class="text-center">Tps réponse moy.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in ts.Days.OrderByDescending(x => x.Date))
                    {
                        <tr>
                            <td class="fw-semibold">
                                @day.Date.ToLocalTime().ToString("ddd dd/MM/yyyy",
                                    new System.Globalization.CultureInfo("fr-FR"))
                            </td>
                            <td class="text-center">
                                @if (day.Calls > 0)
                                {
                                    <span class="badge bg-primary">@day.Calls</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">@day.Missions</td>
                            <td class="text-center">
                                @if (day.CompletedMissions > 0)
                                {
                                    <span class="badge bg-success">@day.CompletedMissions</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (day.AverageResponseTimeMinutes > 0)
                                {
                                    <span class="text-info fw-semibold">@day.AverageResponseTimeMinutes.ToString("F1") min</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div><!-- end tab-evolution -->
</div><!-- end tab-content -->

@section Scripts {
    <script>
    // ── TimeSeries AJAX ────────────────────────────────────────────────────────
    function loadTimeSeries(days) {
        document.querySelectorAll('.ts-btn').forEach(function(b) {
            var d = parseInt(b.dataset.days);
            b.classList.toggle('btn-primary', d === days);
            b.classList.toggle('btn-outline-primary', d !== days);
        });
        document.getElementById('ts-days-label').textContent = days;
        document.getElementById('ts-period-label').textContent = '';
        var badge = document.getElementById('tab-days-badge');
        if (badge) badge.textContent = days + ' j';

        // Keep the form's hidden Days field in sync so date-filter form preserves the selection
        var hiddenDays = document.querySelector('input[name="Days"]');
        if (hiddenDays) hiddenDays.value = days;

        // Update URL without reload so browser back/refresh keeps the period
        var url = new URL(window.location.href);
        url.searchParams.set('days', days);
        history.replaceState({}, '', url.toString());

        document.getElementById('ts-body').innerHTML =
            '<div class="text-center py-5"><div class="spinner-border text-primary" role="status">' +
            '<span class="visually-hidden">Chargement…</span></div></div>';

        fetch('/Dashboard?handler=TimeSeries&days=' + days)
            .then(function(r) { return r.json(); })
            .then(function(ts) { renderTimeSeries(ts, days); })
            .catch(function() {
                document.getElementById('ts-body').innerHTML =
                    '<div class="alert alert-danger m-3">Impossible de charger les données.</div>';
            });
    }

    function deltaBadge(delta, badWhenUp) {
        if (delta === null || delta === undefined)
            return '<span class="badge bg-secondary-subtle text-secondary mt-1">nouveau</span>';
        if (Math.abs(delta) < 0.05)
            return '<span class="badge bg-secondary-subtle text-secondary mt-1">= stable</span>';
        var isUp = delta > 0;
        var isGood = badWhenUp ? !isUp : isUp;
        var cls = isGood ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger';
        var icon = isUp ? 'fa-arrow-up' : 'fa-arrow-down';
        return '<span class="badge ' + cls + ' mt-1"><i class="fa-solid ' + icon + ' me-1"></i>' +
               Math.abs(delta).toFixed(1) + '%</span>';
    }

    function renderTimeSeries(ts, days) {
        var cp = ts.currentPeriod || {}, pp = ts.previousPeriod || {};
        if (cp.periodLabel) {
            document.getElementById('ts-period-label').textContent = '(' + cp.periodLabel + ')';
        }

        var html = '<div class="row g-3 mb-4">';

        html += '<div class="col-md-4"><div class="card border h-100"><div class="card-body text-center">' +
            '<div class="text-muted small fw-semibold text-uppercase mb-1"><i class="fa-solid fa-phone me-1"></i>Appels</div>' +
            '<div class="fs-2 fw-bold text-primary">' + (cp.totalCalls || 0) + '</div>' +
            '<div class="text-muted small">vs ' + (pp.totalCalls || 0) + ' période précédente</div>' +
            deltaBadge(cp.callsDeltaPercent, false) + '</div></div></div>';

        html += '<div class="col-md-4"><div class="card border h-100"><div class="card-body text-center">' +
            '<div class="text-muted small fw-semibold text-uppercase mb-1"><i class="fa-solid fa-flag-checkered me-1"></i>Missions complétées</div>' +
            '<div class="fs-2 fw-bold text-success">' + (cp.completedMissions || 0) + '</div>' +
            '<div class="text-muted small">vs ' + (pp.completedMissions || 0) + ' période précédente</div>' +
            deltaBadge(cp.missionsDeltaPercent, false) + '</div></div></div>';

        html += '<div class="col-md-4"><div class="card border h-100"><div class="card-body text-center">' +
            '<div class="text-muted small fw-semibold text-uppercase mb-1"><i class="fa-solid fa-stopwatch me-1"></i>Temps de réponse moyen</div>' +
            '<div class="fs-2 fw-bold text-info">' + (cp.averageResponseTimeMinutes || 0).toFixed(1) + ' min</div>' +
            '<div class="text-muted small">vs ' + (pp.averageResponseTimeMinutes || 0).toFixed(1) + ' min période préc.</div>' +
            deltaBadge(cp.responseTimeDeltaPercent, true) + '</div></div></div>';

        html += '</div>';

        html += '<div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">' +
            '<thead class="table-dark"><tr>' +
            '<th>Date</th><th class="text-center">Appels</th><th class="text-center">Missions</th>' +
            '<th class="text-center">Complétées</th><th class="text-center">Tps réponse moy.</th>' +
            '</tr></thead><tbody>';

        var daysData = (ts.days || []).slice().sort(function(a, b) { return b.date.localeCompare(a.date); });
        daysData.forEach(function(day) {
            var d = new Date(day.date);
            var dateStr = d.toLocaleDateString('fr-FR', { weekday:'short', day:'2-digit', month:'2-digit', year:'numeric' });
            html += '<tr>' +
                '<td class="fw-semibold">' + dateStr + '</td>' +
                '<td class="text-center">' + (day.calls > 0 ? '<span class="badge bg-primary">' + day.calls + '</span>' : '<span class="text-muted">0</span>') + '</td>' +
                '<td class="text-center">' + day.missions + '</td>' +
                '<td class="text-center">' + (day.completedMissions > 0 ? '<span class="badge bg-success">' + day.completedMissions + '</span>' : '<span class="text-muted">0</span>') + '</td>' +
                '<td class="text-center">' + (day.averageResponseTimeMinutes > 0 ? '<span class="text-info fw-semibold">' + day.averageResponseTimeMinutes.toFixed(1) + ' min</span>' : '<span class="text-muted">—</span>') + '</td>' +
                '</tr>';
        });
        html += '</tbody></table></div>';

        document.getElementById('ts-body').innerHTML = html;
    }
    // ── Missions par heure (Bar chart) ─────────────────────────────────────────
    (function () {
        var ctx = document.getElementById('missionsChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(hoursJson),
                datasets: [{
                    label: 'Missions',
                    data: @Html.Raw(countsJson),
                    backgroundColor: 'rgba(13,110,253,0.7)',
                    borderColor: 'rgba(13,110,253,1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => ctx.parsed.y + ' mission(s)'
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 },
                        title: { display: true, text: 'Nb missions' }
                    },
                    x: {
                        title: { display: true, text: 'Heure' }
                    }
                }
            }
        });
    })();
    </script>
}
