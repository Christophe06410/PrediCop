@page "{id:guid}"
@model PrediCop.BackOffice.Pages.Calls.DetailsModel
@{
    ViewData["Title"] = $"Main courante {Model.Call?.Reference}";
    var call = Model.Call!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="/Calls/Index">Mains courantes</a></li>
            <li class="breadcrumb-item active">@call.Reference</li>
        </ol>
    </nav>
    <div class="d-flex gap-2">
        <a asp-page="/Calls/Edit" asp-route-id="@call.Id" class="btn btn-sm btn-outline-warning">
            <i class="fa-solid fa-pencil me-1"></i>Modifier cet appel
        </a>
        <a asp-page="/Calls/ExportWord" asp-route-id="@call.Id" class="btn btn-sm btn-outline-primary">
            <i class="fa-solid fa-file-word me-1"></i>Rapport Word
        </a>
        <a asp-page="/Calls/Export" asp-route-id="@call.Id" class="btn btn-sm btn-primary" target="_blank">
            <i class="fa-solid fa-file-pdf me-1"></i>Rapport PDF
        </a>
        <a asp-page="/Calls/Index" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Informations de l'appel -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-phone me-2 text-primary"></i>Détails de la main courante
                </h6>
                @await Html.PartialAsync("_StatusBadge", (object)call.Status)
            </div>
            <div class="card-body">
                <dl class="row g-1 mb-0">
                    <dt class="col-sm-4 text-muted">Référence</dt>
                    <dd class="col-sm-8 fw-semibold">@call.Reference</dd>

                    <dt class="col-sm-4 text-muted">Reçu le</dt>
                    <dd class="col-sm-8">@call.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd>

                    <dt class="col-sm-4 text-muted">Opérateur</dt>
                    <dd class="col-sm-8">@call.OperatorName</dd>

                    <dt class="col-sm-4 text-muted">Appelant</dt>
                    <dd class="col-sm-8 fw-semibold">@call.CallerName</dd>

                    <dt class="col-sm-4 text-muted">Téléphone</dt>
                    <dd class="col-sm-8">
                        <a href="tel:@call.CallerPhone">@call.CallerPhone</a>
                    </dd>

                    <dt class="col-sm-4 text-muted">Catégorie</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info text-dark">@call.IncidentCategory</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Localisation -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-map-marker-alt me-2 text-danger"></i>Localisation de l'incident
                </h6>
            </div>
            <div class="card-body">
                <dl class="row g-1 mb-3">
                    <dt class="col-sm-4 text-muted">Adresse</dt>
                    <dd class="col-sm-8 fw-semibold">@call.IncidentAddress</dd>

                    @if (!string.IsNullOrEmpty(call.IncidentAddressComplement))
                    {
                        <dt class="col-sm-4 text-muted">Complément</dt>
                        <dd class="col-sm-8">@call.IncidentAddressComplement</dd>
                    }

                    @if (call.IncidentLatitude.HasValue && call.IncidentLongitude.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">GPS</dt>
                        <dd class="col-sm-8 font-monospace">
                            @call.IncidentLatitude.Value.ToString("F6"), @call.IncidentLongitude.Value.ToString("F6")
                        </dd>
                    }
                </dl>

                @if (call.IncidentLatitude.HasValue && call.IncidentLongitude.HasValue)
                {
                    <div id="map-detail" style="height:180px; border-radius:.5rem;"></div>
                }
            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-file-lines me-2 text-warning"></i>Description &amp; notes
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small text-muted fw-semibold">Description de l'incident</label>
                        <p class="mb-0">@call.IncidentDescription</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted fw-semibold">Tierces personnes</label>
                        <p class="mb-0 @(string.IsNullOrEmpty(call.ThirdParties) ? "text-muted fst-italic" : "")">
                            @(string.IsNullOrEmpty(call.ThirdParties) ? "Aucune" : call.ThirdParties)
                        </p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted fw-semibold">Notes internes</label>
                        <p class="mb-0 @(string.IsNullOrEmpty(call.InternalNotes) ? "text-muted fst-italic" : "text-danger")">
                            @(string.IsNullOrEmpty(call.InternalNotes) ? "Aucune" : call.InternalNotes)
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reprendre l'intervention -->
    @if (Model.CanReopen)
    {
        <div class="col-12">
            <div class="card shadow-sm border-warning border-2">
                <div class="card-header bg-warning bg-opacity-10 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold text-warning">
                        <i class="fa-solid fa-rotate-right me-2"></i>Reprendre l'intervention
                    </h6>
                    <span class="badge bg-warning text-dark">
                        @call.Missions.Count mission(s) antérieure(s)
                    </span>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        Toutes les missions précédentes sont terminées, refusées ou annulées.
                        Vous pouvez envoyer un nouvel équipage sur ce même appel.
                    </p>

                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Référence</th>
                                    <th>Statut</th>
                                    <th>Équipage</th>
                                    <th>Créée le</th>
                                    <th>Terminée le</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in call.Missions.OrderByDescending(x => x.CreatedAt))
                                {
                                    var reopenVehicleId = m.Assignments
                                        .FirstOrDefault(a => a.Status is "Accepted" or "InProgress" or "Proposed")?.VehicleId;
                                    var reopenLabel = m.AssignedVehicleIndicatif ?? m.AssignedVehicleCallSign;
                                    var reopenIcon = m.AssignedVehiclePatrolType switch {
                                        "Motorcycle" => "fa-motorcycle",
                                        "Bicycle"    => "fa-person-biking",
                                        "Pedestrian" => "fa-person-walking",
                                        _            => "fa-car"
                                    };
                                    var reopenTooltipParts = new System.Collections.Generic.List<string>();
                                    if (!string.IsNullOrEmpty(m.AssignedVehicleCallSign)) reopenTooltipParts.Add(m.AssignedVehicleCallSign);
                                    if (!string.IsNullOrEmpty(m.AssignedVehicleLicensePlate)) reopenTooltipParts.Add(m.AssignedVehicleLicensePlate);
                                    if (m.AssignedVehicleOfficerNames.Any()) reopenTooltipParts.Add(string.Join(", ", m.AssignedVehicleOfficerNames));
                                    var reopenTooltip = string.Join(" | ", reopenTooltipParts);
                                    <tr class="text-muted">
                                        <td class="fw-semibold">
                                            <a asp-page="/Missions/Details" asp-route-id="@m.Id" class="text-decoration-none fw-semibold">@m.Reference</a>
                                        </td>
                                        <td>
                                            @await Html.PartialAsync("_StatusBadge", (object)m.Status)
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(reopenLabel) && reopenVehicleId.HasValue)
                                            {
                                                <a asp-page="/Admin/Vehicles/Edit" asp-route-id="@reopenVehicleId"
                                                   class="badge bg-secondary text-decoration-none" title="@reopenTooltip">
                                                    <i class="fa-solid @reopenIcon me-1"></i>@reopenLabel
                                                </a>
                                            }
                                            else if (!string.IsNullOrEmpty(reopenLabel))
                                            {
                                                <span class="badge bg-secondary" title="@reopenTooltip">
                                                    <i class="fa-solid @reopenIcon me-1"></i>@reopenLabel
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(m.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                        <td>
                                            <a asp-page="/Missions/Details" asp-route-id="@m.Id"
                                               class="btn btn-sm btn-outline-secondary py-0">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <form method="post" asp-page-handler="Reopen" asp-route-id="@call.Id"
                          onsubmit="this.querySelector('button[type=submit]').disabled=true;">
                        <button type="submit" class="btn btn-warning fw-semibold">
                            <i class="fa-solid fa-rotate-right me-2"></i>Créer une nouvelle mission sur cet appel
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Missions associées -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-car-side me-2 text-success"></i>Missions associées
                    <span class="badge bg-secondary ms-2">@call.Missions.Count</span>
                </h6>
            </div>
            <div class="card-body p-0">
                @if (call.Missions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Référence</th>
                                    <th>Statut</th>
                                    <th>Adresse cible</th>
                                    <th>Unité</th>
                                    <th>Créée le</th>
                                    <th>Acceptée le</th>
                                    <th>Terminée le</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mission in call.Missions)
                                {
                                    var assocVehicleId = mission.Assignments
                                        .FirstOrDefault(a => a.Status is "Accepted" or "InProgress" or "Proposed")?.VehicleId;
                                    var assocLabel = mission.AssignedVehicleIndicatif ?? mission.AssignedVehicleCallSign;
                                    var assocIcon = mission.AssignedVehiclePatrolType switch {
                                        "Motorcycle" => "fa-motorcycle",
                                        "Bicycle"    => "fa-person-biking",
                                        "Pedestrian" => "fa-person-walking",
                                        _            => "fa-car"
                                    };
                                    var assocTooltipParts = new System.Collections.Generic.List<string>();
                                    if (!string.IsNullOrEmpty(mission.AssignedVehicleCallSign)) assocTooltipParts.Add(mission.AssignedVehicleCallSign);
                                    if (!string.IsNullOrEmpty(mission.AssignedVehicleLicensePlate)) assocTooltipParts.Add(mission.AssignedVehicleLicensePlate);
                                    if (mission.AssignedVehicleOfficerNames.Any()) assocTooltipParts.Add(string.Join(", ", mission.AssignedVehicleOfficerNames));
                                    var assocTooltip = string.Join(" | ", assocTooltipParts);
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-page="/Missions/Details" asp-route-id="@mission.Id" class="text-decoration-none fw-semibold">@mission.Reference</a>
                                        </td>
                                        <td>
                                            @await Html.PartialAsync("_StatusBadge", (object)mission.Status)
                                        </td>
                                        <td>@mission.TargetAddress</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(assocLabel) && assocVehicleId.HasValue)
                                            {
                                                <a asp-page="/Admin/Vehicles/Edit" asp-route-id="@assocVehicleId"
                                                   class="badge bg-dark text-decoration-none" title="@assocTooltip">
                                                    <i class="fa-solid @assocIcon me-1"></i>@assocLabel
                                                </a>
                                            }
                                            else if (!string.IsNullOrEmpty(assocLabel))
                                            {
                                                <span class="badge bg-dark" title="@assocTooltip">
                                                    <i class="fa-solid @assocIcon me-1"></i>@assocLabel
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>@mission.CreatedAt.ToLocalTime().ToString("HH:mm")</td>
                                        <td>@(mission.AcceptedAt?.ToLocalTime().ToString("HH:mm") ?? "—")</td>
                                        <td>@(mission.CompletedAt?.ToLocalTime().ToString("HH:mm") ?? "—")</td>
                                        <td>
                                            <a asp-page="/Missions/Details" asp-route-id="@mission.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        <i class="fa-solid fa-inbox me-2"></i>Aucune mission associée à cette main courante.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Rapports officiels -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-file-lines me-2 text-primary"></i>Rapports officiels
                    <span class="badge bg-secondary ms-2">@call.Reports.Count</span>
                </h6>
                <a asp-page="/Calls/Reports/Create" asp-route-callId="@call.Id"
                   class="btn btn-sm btn-primary">
                    <i class="fa-solid fa-plus me-1"></i>Nouveau rapport
                </a>
            </div>
            <div class="card-body p-0">
                @if (call.Reports.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th>Titre</th>
                                    <th>Auteur</th>
                                    <th>Destinataires</th>
                                    <th>Statut</th>
                                    <th>Rédigé le</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in call.Reports)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @(r.Type switch {
                                                "Information"      => "bg-info text-dark",
                                                "Intervention"     => "bg-success",
                                                "MiseADisposition" => "bg-warning text-dark",
                                                "ProcesVerbal"     => "bg-danger",
                                                _                  => "bg-secondary"
                                            })">@r.TypeLabel</span>
                                        </td>
                                        <td class="fw-semibold">@r.Title</td>
                                        <td class="text-muted small">@r.AuthorName</td>
                                        <td class="small">
                                            @if (r.RecipientLabels.Any())
                                            {
                                                @string.Join(", ", r.RecipientLabels)
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (r.IsDraft)
                                            {
                                                <span class="badge bg-secondary">Brouillon</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Finalisé</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <a asp-page="/Calls/Reports/Edit" asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-warning py-0" title="Modifier">
                                                <i class="fa-solid fa-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        <i class="fa-solid fa-file-slash me-2"></i>Aucun rapport rédigé pour cette main courante.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Documents de suivi (depuis les missions) -->
    @{
        var trackingDocs = call.Missions.SelectMany(m => m.TrackingDocuments).ToList();
    }
    @if (trackingDocs.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa-solid fa-folder-open me-2 text-warning"></i>Documents de suivi
                        <span class="badge bg-secondary ms-2">@trackingDocs.Count</span>
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mission</th>
                                    <th>Type</th>
                                    <th>Référence / Titre</th>
                                    <th>Statut</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in call.Missions.Where(m => m.TrackingDocuments.Any()))
                                {
                                    @foreach (var doc in m.TrackingDocuments)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-page="/Missions/Details" asp-route-id="@m.Id" class="text-decoration-none fw-semibold">@m.Reference</a>
                                            </td>
                                            <td><span class="badge bg-warning text-dark">@doc.Type</span></td>
                                            <td class="fw-semibold">
                                                @doc.Reference
                                                @if (!string.IsNullOrEmpty(doc.Title))
                                                {
                                                    <small class="text-muted ms-1">— @doc.Title</small>
                                                }
                                            </td>
                                            <td><span class="badge bg-secondary">@doc.Status</span></td>
                                            <td class="text-end">
                                                <a asp-page="/Documents/Details" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-warning py-0" title="Voir document">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (call.IncidentLatitude.HasValue && call.IncidentLongitude.HasValue)
    {
        <script>
        var map = L.map('map-detail').setView([@call.IncidentLatitude, @call.IncidentLongitude], 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);
        L.marker([@call.IncidentLatitude, @call.IncidentLongitude])
            .addTo(map)
            .bindPopup('@Html.Raw(call.IncidentAddress.Replace("'", "\\'"))');
        </script>
    }
}
