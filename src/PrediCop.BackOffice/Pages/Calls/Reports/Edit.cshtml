@page "{id:guid}"
@model PrediCop.BackOffice.Pages.Calls.Reports.EditModel
@{
    ViewData["Title"] = "Modifier le rapport";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="/Calls/Index">Mains courantes</a></li>
            <li class="breadcrumb-item">
                <a asp-page="/Calls/Details" asp-route-id="@Model.CallId">@Model.CallReference</a>
            </li>
            <li class="breadcrumb-item active">Modifier le rapport</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-file-pen me-2 text-warning"></i>Modifier le rapport
                </h6>
            </div>
            <div class="card-body">
                <form method="post" id="reportForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label asp-for="Input.Type" class="form-label fw-semibold">Type de rapport</label>
                            <select asp-for="Input.Type" class="form-select" id="reportType">
                                <option value="Information">Rapport d'information</option>
                                <option value="Intervention">Rapport d'intervention</option>
                                <option value="CustodyTransfer">Rapport de mise à disposition</option>
                                <option value="FormalRecord">Procès-verbal</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="Input.Title" class="form-label fw-semibold">Titre</label>
                            <input asp-for="Input.Title" class="form-control" />
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Destinataires</label>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.RecipientMayor" id="recipMayor" />
                                <label class="form-check-label" for="recipMayor">Maire</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.RecipientProsecutor" id="recipProc" />
                                <label class="form-check-label" for="recipProc">Procureur</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.RecipientPrefecture" id="recipPref" />
                                <label class="form-check-label" for="recipPref">Préfecture</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.RecipientHierarchy" id="recipHier" />
                                <label class="form-check-label" for="recipHier">Hiérarchie</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.RecipientDepartment" id="recipDept" />
                                <label class="form-check-label" for="recipDept">Service</label>
                            </div>
                        </div>
                    </div>

                    <!-- Corps (TinyMCE) -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Corps du rapport</label>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnTemplate">
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Recharger le masque
                            </button>
                        </div>
                        <textarea asp-for="Input.Body" id="Input_Body" data-val="false"></textarea>
                        <span asp-validation-for="Input.Body" class="text-danger small" id="bodyError"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Input.IsDraft" id="isDraft" />
                            <label class="form-check-label" for="isDraft">
                                Brouillon
                                <small class="text-muted">(décocher pour finaliser)</small>
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning fw-semibold">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Enregistrer les modifications
                        </button>
                        <a asp-page="/Calls/Details" asp-route-id="@Model.CallId" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/tinymce/tinymce.min.js"></script>
<script>
const TEMPLATES_DATA = @Html.Raw(Model.TemplatesJson);
const TEMPLATES = Object.fromEntries(Object.entries(TEMPLATES_DATA).map(([k, v]) => [k, v.body]));

tinymce.init({
    selector: '#Input_Body',
    base_url: '/lib/tinymce',
    suffix: '.min',
    language: 'fr_FR',
    height: 580,
    menubar: 'file edit view insert format tools',
    plugins: 'lists link image table searchreplace fullscreen wordcount autoresize',
    toolbar:
        'undo redo | fontfamily fontsize | ' +
        'bold italic underline strikethrough | forecolor backcolor | ' +
        'alignleft aligncenter alignright alignjustify | ' +
        'bullist numlist | outdent indent | ' +
        'image link table | searchreplace | fullscreen',
    font_family_formats:
        'Arial=arial,helvetica,sans-serif;' +
        'Calibri=calibri,sans-serif;' +
        'Courier New=courier new,courier,monospace;' +
        'Georgia=georgia,palatino;' +
        'Times New Roman=times new roman,times;' +
        'Verdana=verdana,geneva;',
    font_size_formats: '8pt 9pt 10pt 11pt 12pt 14pt 16pt 18pt 24pt 36pt',
    content_style: `
        body { font-family: Arial, sans-serif; font-size: 11pt; margin: 1.5em 2em; line-height: 1.6; }
        p { margin: 0.4em 0; }
        strong { font-weight: bold; }
    `,
    file_picker_types: 'image',
    images_upload_handler: function(blobInfo) {
        return Promise.resolve('data:' + blobInfo.blob().type + ';base64,' + blobInfo.base64());
    },
    automatic_uploads: false,
    branding: false,
    promotion: false,
    resize: true,
});

document.getElementById('btnTemplate').addEventListener('click', function () {
    const type   = document.getElementById('reportType').value;
    const tpl    = TEMPLATES[type];
    if (!tpl) return;
    const editor = tinymce.get('Input_Body');
    if (!editor) return;
    if (!editor.getContent() || confirm('Remplacer le contenu actuel par le masque ?')) {
        editor.setContent(tpl);
    }
});

document.getElementById('reportForm').addEventListener('submit', function (e) {
    tinymce.triggerSave();
    const body = tinymce.get('Input_Body')?.getContent({ format: 'text' }).trim();
    if (!body) {
        e.preventDefault();
        document.getElementById('bodyError').textContent = 'Le corps du rapport est obligatoire.';
        tinymce.get('Input_Body')?.focus();
    }
});
</script>
}
