<div class="call-timer-bar align-items-center gap-3" id="call-timer-bar-layout" style="display:none">
    <span class="text-warning fw-bold"><i class="fa-solid fa-phone-volume fa-beat me-2"></i>Appel en cours</span>
    <span class="text-white font-monospace" id="call-timer-display">00:00</span>
    <span class="text-secondary small" id="call-timer-label"></span>
    <a asp-page="/Calls/Receive" class="btn btn-sm btn-outline-warning ms-2">
        <i class="fa-solid fa-arrow-right me-1"></i>Retourner à l'appel
    </a>
    <button type="button" id="call-timer-dismiss" class="btn btn-sm btn-outline-secondary ms-auto" title="Fermer la barre d'appel">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>
<script>
(function () {
    var KEY_START = 'predicop_call_start';
    var KEY_END   = 'predicop_call_end';
    var bar       = document.getElementById('call-timer-bar-layout');
    var dismiss   = document.getElementById('call-timer-dismiss');

    console.log('[CallTimer] init — KEY_START=' + sessionStorage.getItem(KEY_START) + ' KEY_END=' + sessionStorage.getItem(KEY_END));

    var saved    = sessionStorage.getItem(KEY_START);
    var savedEnd = sessionStorage.getItem(KEY_END);

    if (!saved || savedEnd) {
        console.log('[CallTimer] barre masquée (saved=' + saved + ', savedEnd=' + savedEnd + ')');
        return;
    }

    var started = new Date(parseInt(saved, 10));
    console.log('[CallTimer] affichage barre — décroché à ' + started.toISOString());

    // d-flex est remplacé par un style inline flex pour éviter le conflit avec !important Bootstrap
    bar.style.display = 'flex';

    var label = document.getElementById('call-timer-label');
    if (label) label.textContent = 'Décroché à ' + started.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});

    function tick() {
        var diff = Math.floor((Date.now() - started) / 1000);
        var el = document.getElementById('call-timer-display');
        if (el) el.textContent = Math.floor(diff / 60).toString().padStart(2, '0') + ':' + (diff % 60).toString().padStart(2, '0');
    }
    tick();
    setInterval(tick, 1000);

    if (!dismiss) {
        console.error('[CallTimer] bouton dismiss introuvable dans le DOM');
        return;
    }

    dismiss.addEventListener('click', function () {
        console.log('[CallTimer] dismiss cliqué — nettoyage sessionStorage');
        [KEY_START, KEY_END, 'predicop_call_form'].forEach(function (k) {
            sessionStorage.removeItem(k);
            console.log('[CallTimer] removeItem(' + k + ')');
        });
        bar.style.display = 'none';
        console.log('[CallTimer] barre masquée après dismiss');
    });
})();
</script>
