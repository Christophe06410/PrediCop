@inject IConfiguration Configuration
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrediCop</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <style>
        html, body { margin: 0; padding: 0; }
        body { background-color: #f0f2f5; }
        .navbar-brand img { height: 32px; }
        /* Navbar — icon above, label below */
        .nav-icon-link {
            display: flex !important;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 0.25rem 0.5rem !important;
            line-height: 1;
        }
        .nav-icon-link > i { font-size: 1rem; margin-bottom: 2px; }
        .nav-text { font-size: 0.6rem; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.04em; opacity: .85; }
        .nav-icon-link.dropdown-toggle::after { display: none; }
        .sidebar { min-height: calc(100vh - 56px); background: #1a2035; }
        .sidebar .nav-link { color: #a0aec0; padding: .5rem 1rem; border-radius: .375rem; margin: 2px 8px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: #2d3a5a; }
        .sidebar .nav-link i { width: 20px; text-align: center; margin-right: 8px; }
        .sidebar .sidebar-heading { color: #4a5568; font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; padding: .5rem 1rem; margin-top: .5rem; }
        .main-content { min-height: calc(100vh - 56px); }
        .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .badge-status-Pending { background-color: #fd7e14; }
        .badge-status-Proposed { background-color: #6f42c1; }
        .badge-status-Accepted { background-color: #0d6efd; }
        .badge-status-InProgress { background-color: #198754; }
        .badge-status-Completed { background-color: #6c757d; }
        .badge-status-Refused { background-color: #dc3545; }
        .badge-status-Cancelled { background-color: #6c757d; }
        .call-timer-bar { background: #1a2035; color: #fff; padding: .4rem 1rem; font-size: .9rem; }
        .kpi-card .kpi-value { font-size: 2rem; font-weight: 700; }
        .kpi-card .kpi-icon { font-size: 2.5rem; opacity: .15; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-page="/Index">
                <img src="~/logo.png" alt="PrediCop" style="height:28px;width:28px;object-fit:contain;" />
                PrediCop
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-page="/Home/Index">
                            <i class="fa-solid fa-house"></i>
                            <span class="nav-text">Accueil</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-page="/Calls/Receive">
                            <i class="fa-solid fa-phone"></i>
                            <span class="nav-text">Réception</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-page="/Calls/Index">
                            <i class="fa-solid fa-list"></i>
                            <span class="nav-text">Main courante</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-page="/Missions/Index">
                            <i class="fa-solid fa-car-side"></i>
                            <span class="nav-text">Missions</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-page="/Crews/Index">
                            <i class="fa-solid fa-users"></i>
                            <span class="nav-text">Équipages</span>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-icon-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-file-contract"></i>
                            <span class="nav-text">Vacations</span>
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-page="/Missions/ShiftReport">
                                    <i class="fa-solid fa-plus me-2 text-primary"></i>Nouveau rapport
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-page="/Missions/ShiftReports">
                                    <i class="fa-solid fa-clock-rotate-left me-2 text-secondary"></i>Historique
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-page="/Map/Index">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <span class="nav-text">Carte</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-page="/Dashboard/Index">
                            <i class="fa-solid fa-gauge"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-icon-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-gear"></i>
                            <span class="nav-text">Admin</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @await Component.InvokeAsync("OptionalModulesMenu")
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-page="/Admin/Subscription/Index"><i class="fa-solid fa-credit-card me-2"></i>Mon abonnement</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-page="/Admin/ReportTemplates/Index"><i class="fa-solid fa-file-code me-2"></i>Masques de rapports</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Audit/Index"><i class="fa-solid fa-clipboard-list me-2"></i>Journal d'audit</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/RgpdRequests/Index"><i class="fa-solid fa-shield-halved me-2"></i>Demandes RGPD</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Settings"><i class="fa-solid fa-sliders me-2"></i>Paramètres</a></li>
                            }
                        </ul>
                    </li>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-icon-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-crown text-warning"></i>
                                <span class="nav-text text-warning">Super Admin</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-page="/SuperAdmin/Tenants/Index"><i class="fa-solid fa-city me-2"></i>Villes / Tenants</a></li>
                            </ul>
                        </li>
                    }
                    <li class="nav-item ms-2 flex-shrink-0">
                        <form asp-page="/Search/Index" method="get" class="d-flex">
                            <div class="input-group input-group-sm">
                                <input type="text" name="Q" class="form-control form-control-sm bg-dark border-secondary text-white"
                                       placeholder="Rechercher..." style="width:150px;"
                                       value="@(ViewContext.HttpContext.Request.Query["Q"].ToString())" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa-solid fa-magnifying-glass text-white"></i>
                                </button>
                            </div>
                        </form>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item ms-2 dropdown">
                            <a class="nav-link dropdown-toggle text-secondary small" href="#" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-circle text-success me-1" style="font-size:.6rem"></i>
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-page="/Account/ChangePassword">
                                        <i class="fa-solid fa-key me-2"></i>Changer mon mot de passe
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form id="logout-form" asp-page="/Account/Logout" method="post" class="d-inline w-100">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i>Se déconnecter
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Timer bar appel en cours — visibilité gérée côté client via sessionStorage -->
    @if (!ViewContext.HttpContext.Request.Path.StartsWithSegments("/Calls/Receive"))
    {
        @if (TempData["ClearCallTimer"] != null)
        {
            <script>(['predicop_call_start','predicop_call_end','predicop_call_form']).forEach(function(k){sessionStorage.removeItem(k);});</script>
        }
        @await Html.PartialAsync("_CallTimer")
    }

    <!-- Messages flash (succès / erreur) issus des handlers Razor Pages -->
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="container-fluid pt-2 pb-0">
            <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="container-fluid pt-2 pb-0">
            <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>@errorMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        </div>
    }

    <!-- Contenu principal -->
    <main class="container-fluid py-3">
        @RenderBody()
    </main>

    <!-- Pied de page -->
    <footer class="bg-dark text-secondary py-2 mt-auto">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <span class="small"><i class="fa-solid fa-shield-halved me-1"></i>PrediCop &copy; @DateTime.Now.Year</span>
            <span class="small">
                <a asp-page="/Rgpd/Index" class="text-secondary text-decoration-none me-3">
                    <i class="fa-solid fa-shield-halved me-1"></i>RGPD
                </a>
                Back-Office v@(System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "?")
            </span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/text-assistant.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <partial name="_TextAssistantModal" />

    <!-- === Modal SOS === -->
    <div class="modal fade" id="sos-alert-modal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="sosAlertLabel" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 bg-danger text-white">
                <div class="modal-header border-0 pb-0">
                    <h4 class="modal-title fw-bold" id="sosAlertLabel">
                        <i class="fa-solid fa-siren-on fa-beat me-2"></i>ALERTE SOS
                    </h4>
                </div>
                <div class="modal-body text-center py-4">
                    <p class="fs-3 fw-bold mb-2" id="sos-reference">—</p>
                    <p class="fs-5 mb-4" id="sos-address">—</p>
                    <div class="d-flex gap-3 justify-content-center">
                        <a id="sos-link" href="#" class="btn btn-light btn-lg text-danger fw-bold">
                            <i class="fa-solid fa-eye me-2"></i>Voir l'appel
                        </a>
                        <button type="button" class="btn btn-outline-light btn-lg" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark me-2"></i>Fermer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- === Toast Container (critiques + missions) === -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div id="critique-toast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="critique-toast-body">
                    <i class="fa-solid fa-fire me-2"></i>APPEL CRITIQUE
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
            </div>
        </div>
        <div id="mission-completed-toast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="polite" aria-atomic="true" data-bs-delay="5000">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="mission-completed-toast-body">
                    &#x2705; Mission — TERMINÉE
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
            </div>
        </div>
        <div id="mission-accepted-toast" class="toast align-items-center text-white bg-primary border-0" role="alert" aria-live="polite" aria-atomic="true" data-bs-delay="5000">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="mission-accepted-toast-body">
                    &#x1F697; Mission acceptée
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
            </div>
        </div>
    </div>

    <!-- === SignalR + Alertes priorité === -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
    (function () {
        // ---- Web Audio beeps ----
        function playAlertBeeps(count) {
            try {
                var ctx = new (window.AudioContext || window.webkitAudioContext)();
                for (var i = 0; i < count; i++) {
                    var osc = ctx.createOscillator();
                    var gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.frequency.value = 880;
                    gain.gain.setValueAtTime(0.3, ctx.currentTime + i * 0.4);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.4 + 0.3);
                    osc.start(ctx.currentTime + i * 0.4);
                    osc.stop(ctx.currentTime + i * 0.4 + 0.3);
                }
            } catch (e) { /* AudioContext non disponible */ }
        }

        function showSosModal(data) {
            document.getElementById('sos-reference').textContent = '🚨 ALERTE SOS — ' + (data.reference || '');
            document.getElementById('sos-address').textContent = data.incidentAddress || '';
            document.getElementById('sos-link').href = '/Calls/Details/' + data.id;
            var modal = new bootstrap.Modal(document.getElementById('sos-alert-modal'));
            modal.show();
            playAlertBeeps(3);
        }

        function showCritiqueToast(data) {
            var body = '⚠️ APPEL CRITIQUE — ' + (data.incidentAddress || '');
            document.getElementById('critique-toast-body').textContent = body;
            var toastEl = document.getElementById('critique-toast');
            var toast = bootstrap.Toast.getOrCreateInstance(toastEl);
            toast.show();
        }

        // ---- SignalR connection (API hub, authentifié par JWT) ----
        var _apiHubUrl = '@(Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7229")' + '/hubs/police';
        var _signalRToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(HttpContextAccessor.HttpContext?.Session.GetString("JwtToken") ?? ""));

        var connection = new signalR.HubConnectionBuilder()
            .withUrl(_apiHubUrl, { accessTokenFactory: function () { return _signalRToken; } })
            .withAutomaticReconnect()
            .build();

        connection.on('NewCallReceived', function (data) {
            var priority = data.priority;
            if (priority === 'SOS' || priority === 3) {
                showSosModal(data);
            } else if (priority === 'Critique' || priority === 2) {
                showCritiqueToast(data);
            }
        });

        connection.on('MissionStatusChanged', function (data) {
            // Rediffuse en évènement DOM pour que les pages (Missions, Détails) se rafraîchissent.
            try { window.dispatchEvent(new CustomEvent('predicop:mission-changed', { detail: data })); } catch (e) {}
            console.debug('[PrediCop] MissionStatusChanged', data && data.reference, data && data.status);

            if (data.status === 'Completed') {
                var body = '✅ Mission ' + (data.reference || '') + ' — TERMINÉE';
                document.getElementById('mission-completed-toast-body').textContent = body;
                var toastEl = document.getElementById('mission-completed-toast');
                bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 5000 }).show();
            } else if (data.status === 'Accepted') {
                var callSign = (data.vehicleCallSign || data.callSign || '');
                var body2 = '🚗 Mission ' + (data.reference || '') + ' acceptée' + (callSign ? ' par ' + callSign : '');
                document.getElementById('mission-accepted-toast-body').textContent = body2;
                var toastEl2 = document.getElementById('mission-accepted-toast');
                bootstrap.Toast.getOrCreateInstance(toastEl2, { delay: 5000 }).show();
            }
        });

        connection.start()
            .then(function () {
                connection.invoke('JoinOperatorGroup').catch(function () {});
            })
            .catch(function (err) {
                console.warn('[PrediCop] SignalR connection failed:', err);
            });

        // Effacer la session d'appel en cours lors de la déconnexion
        // (sessionStorage survit à un logout/login dans le même onglet)
        var logoutForm = document.getElementById('logout-form');
        if (logoutForm) {
            logoutForm.addEventListener('submit', function () {
                ['predicop_call_start', 'predicop_call_end', 'predicop_call_form'].forEach(function (k) {
                    sessionStorage.removeItem(k);
                });
            });
        }
    })();
    </script>
</body>
</html>
