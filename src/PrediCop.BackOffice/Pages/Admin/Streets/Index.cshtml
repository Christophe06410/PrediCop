@page
@model PrediCop.BackOffice.Pages.Admin.Streets.IndexModel
@{
    ViewData["Title"] = "Rues & scores de risque";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-map-location-dot me-2 text-primary"></i>Rues &amp; scores de risque
    </h4>
    @if (User.IsInRole("Admin"))
    {
        <form method="post" asp-page-handler="Recompute"
              onsubmit="return confirm('Recalculer les scores de risque pour toutes les rues ? (quelques secondes)')">
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="fa-solid fa-rotate me-1"></i>Recalculer les risques
            </button>
        </form>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Hidden delete form with CSRF token -->
<form method="post" asp-page-handler="Delete" id="deleteForm" style="display:none">
    <input type="hidden" name="id" id="deleteId" />
</form>

<div class="row g-3">
    <!-- Liste des rues -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa-solid fa-list me-2"></i>Rues enregistrées
                        <span id="streetCount" class="badge bg-secondary ms-2">—</span>
                    </h6>
                </div>
                <!-- Filtres -->
                <div class="row g-2 align-items-center">
                    <div class="col-sm-5">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="text" id="searchInput" class="form-control"
                                   placeholder="Nom, quartier, ville…">
                            <button type="button" class="btn btn-outline-secondary" id="clearSearch"
                                    title="Effacer la recherche" style="display:none">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <select id="riskFilter" class="form-select form-select-sm">
                            <option value="">Tous les risques</option>
                            <option value="high">Élevé (&gt; 70)</option>
                            <option value="medium">Moyen (40–70)</option>
                            <option value="low">Bas (20–40)</option>
                            <option value="minimal">Minimal (&lt; 20)</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <select id="sortOrder" class="form-select form-select-sm">
                            <option value="risk-desc">Risque ↓</option>
                            <option value="risk-asc">Risque ↑</option>
                            <option value="name-asc">Nom A→Z</option>
                            <option value="name-desc">Nom Z→A</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <select id="pageSize" class="form-select form-select-sm">
                            <option value="25" selected>25 / page</option>
                            <option value="50">50 / page</option>
                            <option value="100">100 / page</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0" id="streetsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Rue</th>
                            <th>Quartier / Ville</th>
                            <th>Risque base</th>
                            <th title="Croissance du risque par semaine">Croissance/sem.</th>
                            <th>Risque actuel</th>
                            <th>Dernière patrouille</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="streetsBody">
                        <tr id="loadingRow">
                            <td colspan="7" class="text-center py-4 text-muted">
                                <div class="spinner-border spinner-border-sm me-2"></div>Chargement…
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div id="noResults" class="card-body text-center text-muted py-4" style="display:none">
                <i class="fa-solid fa-filter-circle-xmark fa-2x mb-2 d-block"></i>
                Aucune rue ne correspond aux filtres sélectionnés.
                <br><button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="resetFilters()">Réinitialiser les filtres</button>
            </div>

            <!-- Pagination -->
            <div class="card-footer py-2 d-flex justify-content-between align-items-center" id="paginationContainer" style="display:none">
                <small class="text-muted" id="pageInfo"></small>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="paginationNav"></ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Formulaire ajout -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-plus me-2 text-success"></i>Ajouter une rue
                </h6>
            </div>
            <div class="card-body">
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger py-2 small">@Model.ErrorMessage</div>
                }

                <form method="post" asp-page-handler="Add">
                    <div class="mb-2">
                        <label asp-for="Input.Name" class="form-label fw-semibold small"></label>
                        <input asp-for="Input.Name" class="form-control form-control-sm" placeholder="Rue de la République" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label asp-for="Input.District" class="form-label fw-semibold small"></label>
                            <input asp-for="Input.District" class="form-control form-control-sm" placeholder="Centre" />
                        </div>
                        <div class="col-6">
                            <label asp-for="Input.City" class="form-label fw-semibold small"></label>
                            <input asp-for="Input.City" class="form-control form-control-sm" placeholder="Toulouse" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.BaseRiskScore" class="form-label fw-semibold small"></label>
                        <input asp-for="Input.BaseRiskScore" type="range" class="form-range"
                               min="0" max="100" oninput="document.getElementById('riskVal').textContent=this.value" />
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Faible (0)</span>
                            <span id="riskVal" class="fw-bold">@Model.Input.BaseRiskScore</span>
                            <span>Élevé (100)</span>
                        </div>
                        <span asp-validation-for="Input.BaseRiskScore" class="text-danger small"></span>
                    </div>

                    <hr class="my-2" />
                    <p class="small text-muted mb-2">
                        <i class="fa-solid fa-info-circle me-1"></i>
                        Cliquez sur la carte pour obtenir les coordonnées, ou utilisez
                        <a href="https://www.openstreetmap.org/" target="_blank">OpenStreetMap</a>.
                    </p>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Lat. début</label>
                            <input asp-for="Input.StartLatitude" class="form-control form-control-sm" step="0.000001" type="number" />
                            <span asp-validation-for="Input.StartLatitude" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Lon. début</label>
                            <input asp-for="Input.StartLongitude" class="form-control form-control-sm" step="0.000001" type="number" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Lat. fin</label>
                            <input asp-for="Input.EndLatitude" class="form-control form-control-sm" step="0.000001" type="number" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Lon. fin</label>
                            <input asp-for="Input.EndLongitude" class="form-control form-control-sm" step="0.000001" type="number" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success btn-sm w-100">
                        <i class="fa-solid fa-plus me-2"></i>Ajouter la rue
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Single reusable edit modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="editModalTitle">Modifier une rue</h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editId" />

                    <div class="alert alert-light border py-2 mb-3 small">
                        <i class="fa-solid fa-brain me-1 text-primary"></i>
                        Score calculé par l'algorithme :
                        <span class="badge bg-primary ms-1" id="editComputedScore"></span>
                        <span class="text-muted">/ 100</span>
                        <span class="ms-2 text-muted">— actuel :</span>
                        <span class="badge bg-secondary ms-1" id="editCurrentBase"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input type="hidden" name="isRiskLocked" value="false" />
                        <input type="checkbox" name="isRiskLocked" value="true"
                               class="form-check-input" id="editLock"
                               onchange="toggleEditMode(this.checked)" />
                        <label class="form-check-label small fw-semibold" for="editLock">
                            <i class="fa-solid fa-lock me-1 text-warning"></i>
                            Verrouiller (override absolu, l'algorithme n'y touche plus)
                        </label>
                    </div>

                    <div id="editAbsDiv" class="mb-3" style="display:none">
                        <label class="form-label fw-semibold small">Score absolu (0–100)</label>
                        <input type="number" name="baseRiskScore" id="editBaseRiskScore"
                               class="form-control form-control-sm" min="0" max="100" />
                    </div>

                    <div id="editAdjDiv" class="mb-3">
                        <label class="form-label fw-semibold small">Ajustement relatif (+/-)</label>
                        <input type="number" name="riskAdjustment" id="editRiskAdjustment"
                               class="form-control form-control-sm"
                               placeholder="ex: 10 ou -5 (vide = score brut de l'algo)" />
                        <div class="form-text">Valeur ajoutée au score calculé. Vide = utiliser le score brut.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Croissance par semaine — Jour (0–50)</label>
                        <input type="number" name="riskGrowthRatePerWeek" id="editGrowthRate"
                               class="form-control form-control-sm" min="0" max="50" step="0.1" required />
                    </div>

                    <div class="card bg-dark bg-opacity-10 border-0 p-3 mb-2">
                        <div class="fw-semibold small mb-2">
                            <i class="fa-solid fa-moon me-1 text-primary"></i>Plage horaire de nuit
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small mb-1">Heure de début (0–23)</label>
                                <input type="number" name="nightStartHour" id="editNightStart"
                                       class="form-control form-control-sm" min="0" max="23" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">Heure de fin (0–23)</label>
                                <input type="number" name="nightEndHour" id="editNightEnd"
                                       class="form-control form-control-sm" min="0" max="23" required />
                            </div>
                        </div>
                        <div>
                            <label class="form-label fw-semibold small">Croissance par semaine — Nuit (0–50)</label>
                            <input type="number" name="nightRiskGrowthRatePerWeek" id="editNightGrowthRate"
                                   class="form-control form-control-sm" min="0" max="50" step="0.1" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-sm btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function toggleEditMode(locked) {
        document.getElementById('editAbsDiv').style.display = locked ? '' : 'none';
        document.getElementById('editAdjDiv').style.display = locked ? 'none' : '';
    }

    (function () {
        let currentPage = 1;

        const searchInput = document.getElementById('searchInput');
        const clearBtn    = document.getElementById('clearSearch');
        const riskFilter  = document.getElementById('riskFilter');
        const sortOrder   = document.getElementById('sortOrder');
        const pageSizeEl  = document.getElementById('pageSize');

        function getPageSize() { return parseInt(pageSizeEl.value) || 25; }

        function load(page) {
            currentPage = page;
            var loadingRow = document.getElementById('loadingRow');
            if (loadingRow) loadingRow.style.display = '';
            document.getElementById('noResults').style.display  = 'none';
            document.getElementById('paginationContainer').style.display = 'none';

            const search    = searchInput.value.trim();
            const riskLevel = riskFilter.value;
            const sort      = sortOrder.value;
            const pageSize  = getPageSize();

            const params = new URLSearchParams({ page: page, pageSize: pageSize });
            if (search)    params.set('search', search);
            if (riskLevel) params.set('riskLevel', riskLevel);
            if (sort)      params.set('sort', sort);

            fetch('/Admin/Streets?handler=Search&' + params.toString())
                .then(function(r) { return r.json(); })
                .then(function(data) { render(data); })
                .catch(function() {
                    document.getElementById('streetsBody').innerHTML =
                        '<tr><td colspan="7" class="text-center py-4 text-danger">' +
                        '<i class="fa-solid fa-circle-exclamation me-2"></i>Impossible de charger les rues.</td></tr>';
                });
        }

        function render(data) {
            const tbody    = document.getElementById('streetsBody');
            const total    = data.totalCount || 0;
            const streets  = data.streets || [];
            const pageSize = getPageSize();

            document.getElementById('streetCount').textContent = total;
            var loadingRow = document.getElementById('loadingRow');
            if (loadingRow) loadingRow.remove();

            clearBtn.style.display = (searchInput.value || riskFilter.value) ? '' : 'none';

            if (streets.length === 0) {
                tbody.innerHTML = '';
                document.getElementById('noResults').style.display = '';
                return;
            }

            document.getElementById('noResults').style.display = 'none';

            var html = '';
            streets.forEach(function(s) {
                const badgeClass = s.currentRiskScore > 70 ? 'bg-danger' :
                                   s.currentRiskScore > 40 ? 'bg-warning text-dark' :
                                   s.currentRiskScore > 20 ? 'bg-info text-dark' : 'bg-success';
                const lastPatrol = s.lastPatrolledAt
                    ? new Date(s.lastPatrolledAt).toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' })
                    : 'Jamais';
                const lat = s.startLatitude ? s.startLatitude.toFixed(4) : '';
                const lon = s.startLongitude ? s.startLongitude.toFixed(4) : '';

                const editJson = encodeURIComponent(JSON.stringify({
                    id: s.id, name: s.name,
                    computedBase: s.computedBaseRiskScore,
                    baseRisk: s.baseRiskScore,
                    locked: s.isRiskLocked,
                    adj: s.riskAdjustment,
                    growth: s.riskGrowthRatePerWeek,
                    nightGrowth: s.nightRiskGrowthRatePerWeek,
                    nightStart: s.nightStartHour,
                    nightEnd: s.nightEndHour
                }));

                html += '<tr>' +
                    '<td class="fw-semibold">' + escHtml(s.name) +
                        '<br/><span class="small text-muted">' + lat + ', ' + lon + '</span></td>' +
                    '<td class="text-muted small">' +
                        (s.district ? escHtml(s.district) : '') +
                        (s.city ? ' — ' + escHtml(s.city) : '') + '</td>' +
                    '<td><span class="badge bg-secondary">' + s.baseRiskScore + '</span></td>' +
                    '<td><span class="badge bg-secondary">' + s.riskGrowthRatePerWeek + '</span></td>' +
                    '<td><span class="badge ' + badgeClass + '">' + s.currentRiskScore + '</span></td>' +
                    '<td class="small text-muted">' + lastPatrol + '</td>' +
                    '<td class="text-end" style="white-space:nowrap">' +
                        '<button type="button" class="btn btn-sm btn-outline-secondary me-1" ' +
                            'onclick="openEditModal(decodeURIComponent(\'' + editJson + '\'))">' +
                            '<i class="fa-solid fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-sm btn-outline-danger" ' +
                            'onclick="deleteStreet(\'' + s.id + '\')">' +
                            '<i class="fa-solid fa-trash"></i></button>' +
                    '</td></tr>';
            });
            tbody.innerHTML = html;

            // Pagination
            const totalPages = Math.ceil(total / pageSize);
            const pc = document.getElementById('paginationContainer');
            if (totalPages > 1) {
                pc.style.display = '';
                renderPagination(totalPages, total, pageSize);
            } else {
                pc.style.display = 'none';
                document.getElementById('pageInfo').textContent = total + ' rue(s)';
            }
        }

        function escHtml(s) {
            return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        function renderPagination(totalPages, total, pageSize) {
            const nav = document.getElementById('paginationNav');
            nav.innerHTML = '';
            const from = (currentPage - 1) * pageSize + 1;
            const to   = Math.min(currentPage * pageSize, total);
            document.getElementById('pageInfo').textContent = 'Affichage ' + from + '–' + to + ' sur ' + total;

            function btn(label, pg, disabled, active) {
                const li = document.createElement('li');
                li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                const a = document.createElement('a');
                a.className = 'page-link'; a.href = '#'; a.textContent = label;
                if (!disabled && !active) a.addEventListener('click', function(e) { e.preventDefault(); load(pg); });
                li.appendChild(a); nav.appendChild(li);
            }

            btn('‹', currentPage - 1, currentPage === 1, false);
            const range = 5, half = Math.floor(range / 2);
            let s2 = Math.max(1, currentPage - half);
            let e2 = Math.min(totalPages, s2 + range - 1);
            if (e2 - s2 < range - 1) s2 = Math.max(1, e2 - range + 1);

            if (s2 > 1) { btn('1', 1, false, false); if (s2 > 2) btn('…', 0, true, false); }
            for (let p = s2; p <= e2; p++) btn(p, p, false, p === currentPage);
            if (e2 < totalPages) { if (e2 < totalPages - 1) btn('…', 0, true, false); btn(totalPages, totalPages, false, false); }
            btn('›', currentPage + 1, currentPage === totalPages, false);
        }

        window.openEditModal = function(jsonStr) {
            const data = JSON.parse(jsonStr);
            document.getElementById('editModalTitle').textContent = 'Modifier — ' + data.name;
            document.getElementById('editId').value = data.id;
            document.getElementById('editComputedScore').textContent = data.computedBase;
            document.getElementById('editCurrentBase').textContent = data.baseRisk;
            document.getElementById('editLock').checked = data.locked;
            document.getElementById('editBaseRiskScore').value = data.baseRisk;
            document.getElementById('editRiskAdjustment').value = data.adj ?? '';
            document.getElementById('editGrowthRate').value = data.growth;
            document.getElementById('editNightGrowthRate').value = data.nightGrowth ?? 2.0;
            document.getElementById('editNightStart').value = data.nightStart ?? 22;
            document.getElementById('editNightEnd').value = data.nightEnd ?? 6;
            toggleEditMode(data.locked);
            new bootstrap.Modal(document.getElementById('editModal')).show();
        };

        window.deleteStreet = function(id) {
            if (!confirm('Supprimer cette rue ?')) return;
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteForm').submit();
        };

        window.resetFilters = function() {
            searchInput.value = ''; riskFilter.value = ''; sortOrder.value = 'risk-desc';
            pageSizeEl.value = '25'; clearBtn.style.display = 'none';
            load(1);
        };

        var debounce = null;
        searchInput.addEventListener('input', function() { clearTimeout(debounce); debounce = setTimeout(function() { load(1); }, 350); });
        clearBtn.addEventListener('click', resetFilters);
        riskFilter.addEventListener('change', function() { load(1); });
        sortOrder.addEventListener('change', function() { load(1); });
        pageSizeEl.addEventListener('change', function() { load(1); });

        load(1);
    })();
    </script>
}
