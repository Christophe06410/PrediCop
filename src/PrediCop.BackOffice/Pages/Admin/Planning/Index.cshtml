<!-- Modal import CSV planning -->
<div class="modal fade" id="importCsvModal" tabindex="-1" aria-labelledby="importCsvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="ImportCsv" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WeekStart" value="@Model.WeekStart" />
                <div class="modal-header">
                    <h5 class="modal-title" id="importCsvModalLabel">
                        <i class="fa-solid fa-file-import me-2 text-primary"></i>Import planning CSV
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small mb-3">
                        <strong>Format attendu (virgule ou point-virgule comme séparateur) :</strong><br />
                        <code>Matricule,Nom,Prénom,Date,HeureDebut,HeureFin[,Véhicule][,Notes][,Publié]</code>
                        <ul class="mb-0 mt-1">
                            <li><strong>Matricule</strong> : badge agent (BadgeNumber) — utilisé en priorité</li>
                            <li>Si le matricule est absent ou inconnu, l'agent est recherché par <strong>Nom + Prénom</strong> (insensible à la casse)</li>
                            <li>Si plusieurs agents ont le même nom : la ligne est rejetée (homonyme)</li>
                            <li><strong>Date</strong> : format <code>yyyy-MM-dd</code> ou <code>dd/MM/yyyy</code></li>
                            <li><strong>HeureDebut / HeureFin</strong> : format <code>HH:mm</code></li>
                            <li><strong>Véhicule</strong> (optionnel) : indicatif radio (CallSign)</li>
                            <li><strong>Publié</strong> (optionnel) : <code>1</code>, <code>true</code>, <code>oui</code></li>
                        </ul>
                    </div>
                    <div class="mb-3">
                        <label for="csvFile" class="form-label fw-semibold">
                            Fichier CSV <span class="text-danger">*</span>
                        </label>
                        <input type="file" name="csvFile" id="csvFile" class="form-control"
                               accept=".csv,text/csv,text/plain" required />
                        <div class="form-text">Un créneau existant pour le même agent + même date sera mis à jour.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-upload me-1"></i>Importer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Données d'occupation des véhicules pour la semaine (clé = "yyyy-MM-dd")
        const weekOccupancy = @Html.Raw(JsonSerializer.Serialize(Model.WeekOccupancy));

        // Droits à congés : tableau [{agentId, type, totalDays, usedDays, remainingDays}]
        const entitlements = @Html.Raw(JsonSerializer.Serialize(
            Model.Entitlements.Select(e => new {
                agentId = e.AgentId,
                type = e.Type.ToString(),
                totalDays = e.TotalDays,
                usedDays = e.UsedDays,
                remainingDays = e.RemainingDays
            }).ToList()
        ));

        function updateLeaveBalanceHint() {
            const agentId = document.getElementById('leaveAgentId').value;
            const leaveType = document.getElementById('leaveType').value;
            const hint = document.getElementById('leaveBalanceHint');

            if (!agentId || !leaveType) { hint.textContent = ''; return; }
            if (leaveType === 'Maladie') {
                hint.innerHTML = '<span class="text-info"><i class="fa-solid fa-infinity me-1"></i>Maladie : illimité</span>';
                return;
            }

            const matches = entitlements.filter(e => e.agentId === agentId && e.type === leaveType);
            if (matches.length === 0) {
                hint.innerHTML = '<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>Aucun droit défini pour ce type</span>';
                return;
            }

            const totalRemaining = matches.reduce((s, e) => s + e.remainingDays, 0);
            const totalDays = matches.reduce((s, e) => s + e.totalDays, 0);
            const color = totalRemaining <= 0 ? 'danger' : totalRemaining < 3 ? 'warning' : 'success';
            hint.innerHTML = `<span class="text-${color}"><i class="fa-solid fa-circle-check me-1"></i>Solde : ${totalRemaining.toFixed(1)} / ${totalDays.toFixed(1)} jours restants</span>`;
        }

        document.getElementById('leaveAgentId').addEventListener('change', updateLeaveBalanceHint);
        document.getElementById('leaveType').addEventListener('change', updateLeaveBalanceHint);

        /**
         * Met à jour le <select> des véhicules selon la date choisie dans la modal.
         * Affiche "CallSign (X/Y places)" et désactive l'option si le véhicule est plein,
         * sauf si c'est le véhicule déjà sélectionné pour ce créneau (pour permettre l'édition).
         */
        function updateVehicleSelect(dateStr, currentVehicleId) {
            const select = document.getElementById('shiftVehicleId');
            const hint = document.getElementById('vehicleCapacityHint');
            const occupancyForDay = weekOccupancy[dateStr] ?? [];
            const occMap = {};
            occupancyForDay.forEach(o => { occMap[o.vehicleId] = o; });

            Array.from(select.options).forEach(opt => {
                if (!opt.value) return; // "— Aucun —"
                const capacity = parseInt(opt.getAttribute('data-capacity') ?? '2', 10);
                const callSign = opt.getAttribute('data-callsign') ?? '';
                const plate = opt.getAttribute('data-plate') ?? '';
                const occ = occMap[opt.value];
                const count = occ ? occ.count : 0;

                // Si c'est le véhicule déjà assigné à ce créneau, ne pas le compter comme occupé par lui-même
                const effectiveCount = (currentVehicleId && opt.value === currentVehicleId) ? Math.max(0, count - 1) : count;
                const isFull = effectiveCount >= capacity;

                opt.textContent = `${callSign} (${count}/${capacity} places)`;
                opt.disabled = isFull;
                if (isFull) {
                    opt.textContent += ' — complet';
                }
            });

            // Mettre à jour le hint si un véhicule est sélectionné
            updateCapacityHint(select, occMap, currentVehicleId);
        }

        function updateCapacityHint(select, occMap, currentVehicleId) {
            const hint = document.getElementById('vehicleCapacityHint');
            const selectedOpt = select.options[select.selectedIndex];
            if (!selectedOpt || !selectedOpt.value) {
                hint.textContent = '';
                return;
            }
            const capacity = parseInt(selectedOpt.getAttribute('data-capacity') ?? '2', 10);
            const occ = occMap ? occMap[selectedOpt.value] : null;
            const count = occ ? occ.count : 0;
            const agents = occ ? occ.agentNames : [];
            const remaining = capacity - count;
            if (remaining <= 0) {
                hint.innerHTML = `<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Véhicule complet — ${agents.join(', ')}</span>`;
            } else {
                const agentList = agents.length > 0 ? ` (${agents.join(', ')})` : '';
                hint.innerHTML = `<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>${remaining} place(s) disponible(s)${agentList}</span>`;
            }
        }

        // Alimenter la modal de refus avec les données de la ligne
        document.getElementById('rejectModal').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('rejectLeaveId').value = btn.getAttribute('data-leave-id');
            document.getElementById('rejectAgentName').textContent = btn.getAttribute('data-agent-name');
            document.getElementById('rejectionReason').value = '';
        });

        // Alimenter la modal de créneau avec les données du bouton cliqué
        document.getElementById('shiftModal').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            if (!btn) return;
            const agentId = btn.getAttribute('data-agent-id') ?? '';
            const dateStr = btn.getAttribute('data-date') ?? '';
            const shiftStart = btn.getAttribute('data-shift-start');
            const vehicleId = btn.getAttribute('data-vehicle-id') ?? '';

            document.getElementById('shiftAgentId').value = agentId;
            document.getElementById('shiftDate').value = dateStr;

            if (shiftStart) {
                document.getElementById('shiftStart').value = shiftStart;
                document.getElementById('shiftEnd').value = btn.getAttribute('data-shift-end') ?? '';
                document.getElementById('shiftVehicleId').value = vehicleId;
                document.getElementById('shiftNotes').value = btn.getAttribute('data-notes') ?? '';
                document.getElementById('shiftIsPublished').checked = btn.getAttribute('data-is-published') === 'true';
            } else {
                document.getElementById('shiftStart').value = '08:00';
                document.getElementById('shiftEnd').value = '16:00';
                document.getElementById('shiftVehicleId').value = '';
                document.getElementById('shiftNotes').value = '';
                document.getElementById('shiftIsPublished').checked = false;
            }

            updateVehicleSelect(dateStr, vehicleId);
        });

        // Mettre à jour le select quand la date change dans la modal
        document.getElementById('shiftDate').addEventListener('change', function () {
            const vehicleId = document.getElementById('shiftVehicleId').value;
            updateVehicleSelect(this.value, vehicleId);
        });

        // Mettre à jour le hint quand le véhicule sélectionné change
        document.getElementById('shiftVehicleId').addEventListener('change', function () {
            const dateStr = document.getElementById('shiftDate').value;
            const occForDay = weekOccupancy[dateStr] ?? [];
            const occMap = {};
            occForDay.forEach(o => { occMap[o.vehicleId] = o; });
            updateCapacityHint(this, occMap, null);
        });
    </script>
}
