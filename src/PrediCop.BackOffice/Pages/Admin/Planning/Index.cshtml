@page
@model PrediCop.BackOffice.Pages.Admin.Planning.IndexModel
@using PrediCop.Core.Enums
@using System.Text.Json
@{
    ViewData["Title"] = "Planning & Congés";

    // Week navigation
    var weekStartDate = DateOnly.TryParse(Model.WeekStart, out var ws) ? ws : DateOnly.FromDateTime(DateTime.Now);
    // Always snap to the Monday of the week so dayNames[] stays aligned with weekDays[]
    weekStartDate = weekStartDate.AddDays(-(((int)weekStartDate.DayOfWeek - 1 + 7) % 7));
    var prevWeek = weekStartDate.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = weekStartDate.AddDays(7).ToString("yyyy-MM-dd");
    var weekDays = Enumerable.Range(0, 7).Select(i => weekStartDate.AddDays(i)).ToList();
    var dayNames = new[] { "Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim" };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-calendar-days me-2 text-primary"></i>Planning &amp; Congés
    </h4>
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ImportErrors"] is string importErrorsJson)
{
    var importErrors = System.Text.Json.JsonSerializer.Deserialize<List<PrediCop.Core.DTOs.CsvImportError>>(
        importErrorsJson,
        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
    if (importErrors.Count > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong><i class="fa-solid fa-triangle-exclamation me-2"></i>Erreurs d'import CSV (@importErrors.Count ligne(s)) :</strong>
            <ul class="mb-0 mt-1 small">
                @foreach (var err in importErrors)
                {
                    <li><strong>Ligne @err.LineNumber :</strong> @err.Message <span class="text-muted fst-italic">(@err.RawLine)</span></li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
}

@if (Model.PendingLeavesCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="fa-solid fa-clock me-2 fs-5"></i>
        <span>
            <strong>@Model.PendingLeavesCount demande(s) de congé en attente d'approbation.</strong>
            <a href="#" class="alert-link ms-1"
               onclick="document.getElementById('tab-conges').click(); return false;">
                Voir les demandes
            </a>
        </span>
    </div>
}

<!-- Onglets -->
<ul class="nav nav-tabs mb-3" id="hrTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "planning" ? "active" : "")"
                id="tab-planning"
                data-bs-toggle="tab"
                data-bs-target="#pane-planning"
                type="button" role="tab">
            <i class="fa-solid fa-calendar-days me-1"></i>Planning
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "conges" ? "active" : "")"
                id="tab-conges"
                data-bs-toggle="tab"
                data-bs-target="#pane-conges"
                type="button" role="tab">
            <i class="fa-solid fa-umbrella-beach me-1"></i>Congés
            @if (Model.PendingLeavesCount > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@Model.PendingLeavesCount</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content">

    <!-- ===== ONGLET PLANNING ===== -->
    <div class="tab-pane fade @(Model.ActiveTab == "planning" ? "show active" : "")"
         id="pane-planning" role="tabpanel">

        <!-- Filtres planning -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form method="get" class="row g-2 align-items-end">
                    <input type="hidden" name="ActiveTab" value="planning" />
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Agent</label>
                        <select name="AgentFilter" class="form-select form-select-sm">
                            <option value="">— Tous les agents —</option>
                            @foreach (var agent in Model.Agents)
                            {
                                <option value="@agent.Id"
                                        selected="@(Model.AgentFilter == agent.Id ? "selected" : null)">
                                    @agent.FullName (@agent.BadgeNumber)
                                </option>
                            }
                        </select>
                    </div>
                    <input type="hidden" name="WeekStart" value="@Model.WeekStart" />
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Filtrer
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Navigation semaine -->
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <a asp-page="/Admin/Planning/Index"
               asp-route-WeekStart="@prevWeek"
               asp-route-ActiveTab="planning"
               asp-route-AgentFilter="@Model.AgentFilter"
               class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-chevron-left"></i> Sem. préc.
            </a>
            <span class="fw-semibold">
                Semaine du @weekStartDate.ToString("dd/MM/yyyy") au @weekStartDate.AddDays(6).ToString("dd/MM/yyyy")
            </span>
            <a asp-page="/Admin/Planning/Index"
               asp-route-WeekStart="@nextWeek"
               asp-route-ActiveTab="planning"
               asp-route-AgentFilter="@Model.AgentFilter"
               class="btn btn-outline-secondary btn-sm">
                Sem. suiv. <i class="fa-solid fa-chevron-right"></i>
            </a>
            <button type="button" class="btn btn-primary btn-sm ms-auto"
                    data-bs-toggle="modal" data-bs-target="#shiftModal">
                <i class="fa-solid fa-plus me-1"></i>Ajouter un créneau
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-bs-toggle="modal" data-bs-target="#importCsvModal"
                    title="Importer un planning depuis un fichier CSV">
                <i class="fa-solid fa-file-import me-1"></i>Import CSV
            </button>
        </div>

        <!-- Tableau planning -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="min-width:160px">Agent</th>
                                @for (int d = 0; d < 7; d++)
                                {
                                    var day = weekDays[d];
                                    var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                                    <th class="text-center @(isToday ? "table-warning" : "")" style="min-width:110px">
                                        @dayNames[d]<br />
                                        <small>@day.ToString("dd/MM")</small>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                // Group schedules by agent
                                var agentIds = Model.Schedules.Select(s => s.AgentId).Distinct().ToList();

                                // Also include agents from filter if no schedules
                                if (!agentIds.Any() && Model.Agents.Any())
                                {
                                    agentIds = Model.Agents.Select(a => a.Id).Take(10).ToList();
                                }

                                if (!agentIds.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            <i class="fa-solid fa-calendar-xmark fa-2x mb-2 d-block"></i>
                                            Aucun planning pour cette semaine.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var agentId in agentIds)
                                    {
                                        var agentSchedules = Model.Schedules.Where(s => s.AgentId == agentId).ToList();
                                        var agentName = agentSchedules.FirstOrDefault()?.AgentFullName
                                            ?? Model.Agents.FirstOrDefault(a => a.Id == agentId)?.FullName
                                            ?? "Agent inconnu";
                                        var agentBadge = agentSchedules.FirstOrDefault()?.AgentBadgeNumber
                                            ?? Model.Agents.FirstOrDefault(a => a.Id == agentId)?.BadgeNumber
                                            ?? "";

                                        <tr>
                                            <td class="fw-semibold small">
                                                <i class="fa-solid fa-user-shield me-1 text-secondary"></i>
                                                @agentName
                                                <br />
                                                <span class="badge bg-secondary fw-normal">@agentBadge</span>
                                            </td>
                                            @foreach (var day in weekDays)
                                            {
                                                var shift = agentSchedules.FirstOrDefault(s => s.Date == day);
                                                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                                                var dayStr = day.ToString("yyyy-MM-dd");
                                                <td class="text-center p-1 @(isToday ? "table-warning" : "")">
                                                    @if (shift is not null)
                                                    {
                                                        var startStr = shift.ShiftStart.ToString("HH:mm");
                                                        var endStr = shift.ShiftEnd.ToString("HH:mm");
                                                        <div class="d-flex flex-column align-items-center gap-1">
                                                            <span class="badge bg-primary text-wrap">
                                                                @startStr–@endStr
                                                                @if (!string.IsNullOrEmpty(shift.VehicleCallSign))
                                                                {
                                                                    <br /><small>@shift.VehicleCallSign</small>
                                                                }
                                                            </span>
                                                            <div class="d-flex gap-1">
                                                                <button type="button"
                                                                        class="btn btn-outline-primary btn-sm py-0 px-1"
                                                                        title="Modifier"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#shiftModal"
                                                                        data-agent-id="@agentId"
                                                                        data-date="@dayStr"
                                                                        data-shift-start="@startStr"
                                                                        data-shift-end="@endStr"
                                                                        data-vehicle-id="@shift.VehicleId"
                                                                        data-is-published="@shift.IsPublished.ToString().ToLower()"
                                                                        data-notes="@(shift.Notes ?? "")">
                                                                    <i class="fa-solid fa-pen fa-xs"></i>
                                                                </button>
                                                                <form method="post" asp-page-handler="DeleteShift" class="d-inline"
                                                                      onsubmit="return confirm('Supprimer ce créneau ?')">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@shift.Id" />
                                                                    <input type="hidden" name="WeekStart" value="@Model.WeekStart" />
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Supprimer">
                                                                        <i class="fa-solid fa-trash fa-xs"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-secondary btn-sm py-0 px-2"
                                                                title="Ajouter un créneau"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#shiftModal"
                                                                data-agent-id="@agentId"
                                                                data-date="@dayStr">
                                                            <i class="fa-solid fa-plus fa-xs"></i>
                                                        </button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== ONGLET CONGES ===== -->
    <div class="tab-pane fade @(Model.ActiveTab == "conges" ? "show active" : "")"
         id="pane-conges" role="tabpanel">

        <!-- Filtres congés -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form method="get" class="row g-2 align-items-end">
                    <input type="hidden" name="ActiveTab" value="conges" />
                    <input type="hidden" name="WeekStart" value="@Model.WeekStart" />
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Agent</label>
                        <select name="AgentFilter" class="form-select form-select-sm">
                            <option value="">— Tous les agents —</option>
                            @foreach (var agent in Model.Agents)
                            {
                                <option value="@agent.Id"
                                        selected="@(Model.AgentFilter == agent.Id ? "selected" : null)">
                                    @agent.FullName (@agent.BadgeNumber)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Filtrer
                        </button>
                        <a asp-page="/Admin/Planning/Index"
                           asp-route-ActiveTab="conges"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="fa-solid fa-xmark me-1"></i>Réinitialiser
                        </a>
                        <button type="button" class="btn btn-success btn-sm"
                                data-bs-toggle="modal" data-bs-target="#newLeaveModal">
                            <i class="fa-solid fa-plus me-1"></i>Nouvelle demande
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tableau congés -->
        <div class="card shadow-sm mb-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>Agent</th>
                                <th>Type</th>
                                <th>Du</th>
                                <th>Au</th>
                                <th>Statut</th>
                                <th>Demandé le</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in Model.Leaves)
                            {
                                <tr>
                                    <td>
                                        <i class="fa-solid fa-user-shield me-1 text-secondary"></i>
                                        <span class="fw-semibold">@leave.AgentFullName</span>
                                        <br />
                                        <small class="text-muted">@leave.AgentBadgeNumber</small>
                                    </td>
                                    <td>@Model.GetLeaveTypeLabel(leave.Type)</td>
                                    <td class="text-nowrap">@leave.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-nowrap">@leave.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @Model.GetLeaveStatusBadgeClass(leave.Status)">
                                            @(leave.Status switch {
                                                LeaveStatus.Pending => "En attente",
                                                LeaveStatus.Approved => "Approuvé",
                                                LeaveStatus.Rejected => "Refusé",
                                                _ => leave.Status.ToString()
                                            })
                                        </span>
                                        @if (leave.Status == LeaveStatus.Rejected && !string.IsNullOrEmpty(leave.RejectionReason))
                                        {
                                            <br />
                                            <small class="text-danger">@leave.RejectionReason</small>
                                        }
                                    </td>
                                    <td class="text-nowrap small text-muted">
                                        @leave.RequestedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="small text-muted">@leave.Notes</td>
                                    <td class="text-center text-nowrap">
                                        @if (leave.Status == LeaveStatus.Pending)
                                        {
                                            <!-- Approuver -->
                                            <form method="post"
                                                  asp-page-handler="ApproveLeave"
                                                  asp-route-id="@leave.Id"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Approuver le congé de @leave.AgentFullName ?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm"
                                                        title="Approuver">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </form>

                                            <!-- Refuser -->
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    title="Refuser"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal"
                                                    data-leave-id="@leave.Id"
                                                    data-agent-name="@leave.AgentFullName">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Leaves.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                        Aucune demande de congé trouvée.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Section Soldes de congés -->
        @{
            var agentsWithEntitlements = Model.Entitlements
                .GroupBy(e => new { e.AgentId, e.AgentFullName })
                .OrderBy(g => g.Key.AgentFullName)
                .ToList();
            var leaveTypesForBalance = new[] {
                LeaveType.CongesPayes, LeaveType.RTT, LeaveType.Formation,
                LeaveType.RecupHeure, LeaveType.Autre
            };
        }
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold">
                    <i class="fa-solid fa-chart-pie me-2 text-info"></i>Soldes de congés
                </h6>
                <button type="button" class="btn btn-outline-primary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#newEntitlementModal">
                    <i class="fa-solid fa-plus me-1"></i>Attribuer un droit
                </button>
            </div>
            <div class="card-body p-0">
                @if (!agentsWithEntitlements.Any())
                {
                    <p class="text-muted text-center py-4 mb-0">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Aucun droit à congés défini. Utilisez "Attribuer un droit" pour commencer.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Agent</th>
                                    @foreach (var lt in leaveTypesForBalance)
                                    {
                                        <th class="text-center">@Model.GetLeaveTypeLabel(lt)</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grp in agentsWithEntitlements)
                                {
                                    <tr>
                                        <td class="fw-semibold">@grp.Key.AgentFullName</td>
                                        @foreach (var lt in leaveTypesForBalance)
                                        {
                                            var label = Model.GetBalanceLabel(grp.Key.AgentId, lt);
                                            var hasEntitlement = Model.GetEntitlements(grp.Key.AgentId, lt).Any();
                                            <td class="text-center small">
                                                @if (hasEntitlement)
                                                {
                                                    <span class="badge bg-light text-dark border">@label</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal créneau planning (créer / modifier) -->
<div class="modal fade" id="shiftModal" tabindex="-1" aria-labelledby="shiftModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpsertShift" id="shiftForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WeekStart" value="@Model.WeekStart" />
                <div class="modal-header">
                    <h5 class="modal-title" id="shiftModalLabel">
                        <i class="fa-solid fa-calendar-plus me-2 text-primary"></i>Créneau de travail
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Agent <span class="text-danger">*</span></label>
                        <select name="agentId" id="shiftAgentId" class="form-select" required>
                            <option value="">— Sélectionner un agent —</option>
                            @foreach (var agent in Model.Agents)
                            {
                                <option value="@agent.Id">@agent.FullName (@agent.BadgeNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                        <input type="date" name="date" id="shiftDate" class="form-control" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label fw-semibold">Début <span class="text-danger">*</span></label>
                            <input type="time" name="shiftStart" id="shiftStart" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label fw-semibold">Fin <span class="text-danger">*</span></label>
                            <input type="time" name="shiftEnd" id="shiftEnd" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Véhicule</label>
                        <select name="vehicleId" id="shiftVehicleId" class="form-select">
                            <option value="">— Aucun —</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id"
                                        data-capacity="@v.Capacity"
                                        data-callsign="@v.CallSign"
                                        data-plate="@v.LicensePlate">
                                    @v.CallSign (@v.LicensePlate)
                                </option>
                            }
                        </select>
                        <div id="vehicleCapacityHint" class="form-text text-muted"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <input type="text" name="notes" id="shiftNotes" class="form-control" placeholder="Optionnel" />
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="isPublished" id="shiftIsPublished" class="form-check-input" value="true" />
                        <label class="form-check-label" for="shiftIsPublished">Publié (visible par l'agent)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal nouvelle demande de congé -->
<div class="modal fade" id="newLeaveModal" tabindex="-1" aria-labelledby="newLeaveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateLeave">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="newLeaveModalLabel">
                        <i class="fa-solid fa-umbrella-beach me-2 text-success"></i>Nouvelle demande de congé
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Agent <span class="text-danger">*</span></label>
                        <select name="agentId" id="leaveAgentId" class="form-select" required>
                            <option value="">— Sélectionner un agent —</option>
                            @foreach (var agent in Model.Agents)
                            {
                                <option value="@agent.Id">@agent.FullName (@agent.BadgeNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Type de congé <span class="text-danger">*</span></label>
                        <select name="leaveType" id="leaveType" class="form-select" required>
                            <option value="CongesPayes">Congés payés</option>
                            <option value="RTT">RTT</option>
                            <option value="Maladie">Maladie</option>
                            <option value="Formation">Formation</option>
