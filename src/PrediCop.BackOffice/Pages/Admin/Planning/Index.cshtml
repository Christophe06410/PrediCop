    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateEntitlement">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="newEntitlementModalLabel">
                        <i class="fa-solid fa-calendar-plus me-2 text-primary"></i>Attribuer un droit à congés
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Agent <span class="text-danger">*</span></label>
                        <select name="agentId" class="form-select" required>
                            <option value="">— Sélectionner un agent —</option>
