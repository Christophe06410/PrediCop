@page
@model PrediCop.BackOffice.Pages.Admin.ReportTemplates.IndexModel
@{
    ViewData["Title"] = "Masques de rapports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-semibold">
        <i class="fa-solid fa-file-code me-2 text-primary"></i>Masques de rapports
    </h5>
</div>

<p class="text-muted small mb-4">
    Personnalisez le contenu par défaut chargé lors de la rédaction de chaque type de rapport.
    Les modifications s'appliquent à tous les agents de votre organisation.
</p>

<div class="row g-3">
    @foreach (var tpl in Model.Templates)
    {
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="fw-semibold mb-0">@tpl.TypeLabel</h6>
                        @if (tpl.IsCustomized)
                        {
                            <span class="badge bg-success-subtle text-success">Personnalisé</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Par défaut</span>
                        }
                    </div>
                    <p class="text-muted small mb-3">Titre suggéré : <em>@tpl.DefaultTitle</em></p>
                    @if (tpl.IsCustomized && tpl.UpdatedAt.HasValue)
                    {
                        <p class="text-muted small mb-3">
                            Modifié le @tpl.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")
                        </p>
                    }
                    <div class="mt-auto d-flex gap-2">
                        <a asp-page="Edit" asp-route-type="@tpl.Type" class="btn btn-sm btn-primary">
                            <i class="fa-solid fa-pen me-1"></i>Modifier
                        </a>
                        @if (tpl.IsCustomized)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger btn-reset"
                                    data-type="@tpl.Type" data-label="@tpl.TypeLabel">
                                <i class="fa-solid fa-rotate-left me-1"></i>Remettre par défaut
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
document.querySelectorAll('.btn-reset').forEach(btn => {
    btn.addEventListener('click', async function () {
        if (!confirm(`Remettre le masque "${this.dataset.label}" aux valeurs par défaut ?`)) return;
        const r = await fetch(`/api/report-templates/${this.dataset.type}`, { method: 'DELETE' });
        if (r.ok || r.status === 204) location.reload();
        else alert('Erreur lors de la remise à zéro.');
    });
});
</script>
}
