@page "{id:guid?}"
@model PrediCop.BackOffice.Pages.Admin.RiskEvents.EditModel
@{
    var isNew = Model.EventId == null;
    ViewData["Title"] = isNew ? "Nouvel événement de risque" : "Modifier l'événement de risque";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="/Admin/RiskEvents/Index">Événements de risque</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
    <a asp-page="/Admin/RiskEvents/Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa-solid fa-triangle-exclamation me-2 text-warning"></i>
                    @(isNew ? "Créer un événement de risque" : "Modifier l'événement")
                </h6>
            </div>
            <div class="card-body">
                <form method="post" asp-route-id="@Model.EventId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="StreetId" id="streetIdInput" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rue <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            <input type="text" id="streetSearch" class="form-control"
                                   placeholder="Rechercher une rue par nom…"
                                   value="@Model.StreetName"
                                   autocomplete="off" />
                            <div id="streetSuggestions" class="list-group shadow position-absolute w-100" style="z-index:1050;display:none;max-height:220px;overflow-y:auto;"></div>
                        </div>
                        @if (Model.StreetId != Guid.Empty)
                        {
                            <div class="form-text text-muted small">
                                <i class="fa-solid fa-location-dot me-1"></i>Rue sélectionnée : <strong>@Model.StreetName</strong>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">
                            Titre <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="Ex : Marché hebdomadaire" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Description de l'événement..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RiskPoints" class="form-label fw-semibold">
                            Points de risque <span class="text-danger">*</span>
                        </label>
                        <input asp-for="RiskPoints" type="number" class="form-control"
                               min="1" max="100" required />
                        <div class="form-text">Nombre de points ajoutés au score de risque de la rue.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label fw-semibold">
                                Date de l'événement <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EventDate" type="datetime-local" class="form-control"
                                   value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpiresAt" class="form-label fw-semibold">
                                Date d'expiration <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ExpiresAt" type="datetime-local" class="form-control"
                                   value="@Model.ExpiresAt.ToString("yyyy-MM-ddTHH:mm")" required />
                            <div class="form-text">Le risque s'applique jusqu'à cette date.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Source" class="form-label fw-semibold">Source</label>
                        <input asp-for="Source" class="form-control"
                               placeholder="Ex : Mairie, Préfecture, Signal citoyen..." />
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="fw-semibold mb-2">
                            <i class="fa-solid fa-rotate me-2 text-primary"></i>Récurrence
                        </div>
                        <div class="mb-2">
                            <label asp-for="RecurrenceType" class="form-label fw-semibold small">Fréquence</label>
                            <select asp-for="RecurrenceType" id="recurrenceType" class="form-select"
                                    onchange="toggleRecurrenceEnd()">
                                <option value="0">Aucune (événement ponctuel)</option>
                                <option value="1">Quotidienne</option>
                                <option value="2">Hebdomadaire</option>
                                <option value="3">Mensuelle</option>
                                <option value="4">Annuelle</option>
                            </select>
                            <div class="form-text">
                                La plage horaire entre <em>Date de l'événement</em> et <em>Date d'expiration</em>
                                se répétera à la fréquence choisie.
                            </div>
                        </div>
                        <div id="recurrenceEndGroup" style="display:none">
                            <label asp-for="RecurrenceEndDate" class="form-label fw-semibold small">
                                Fin de récurrence <span class="text-muted fw-normal">(optionnel)</span>
                            </label>
                            <input asp-for="RecurrenceEndDate" type="date" class="form-control"
                                   value="@(Model.RecurrenceEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                            <div class="form-text">Laisser vide pour une récurrence sans fin.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-2"></i>@(isNew ? "Créer l'événement" : "Enregistrer")
                        </button>
                        <a asp-page="/Admin/RiskEvents/Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-xmark me-1"></i>Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleRecurrenceEnd() {
    const val = document.getElementById('recurrenceType').value;
    document.getElementById('recurrenceEndGroup').style.display = val === '0' ? 'none' : '';
}
toggleRecurrenceEnd();
</script>
<script>
(function () {
    const searchInput  = document.getElementById('streetSearch');
    const hiddenInput  = document.getElementById('streetIdInput');
    const suggestions  = document.getElementById('streetSuggestions');
    let debounce;

    searchInput.addEventListener('input', () => {
        clearTimeout(debounce);
        const q = searchInput.value.trim();
        if (q.length < 2) { suggestions.style.display = 'none'; return; }
        debounce = setTimeout(() => fetchStreets(q), 250);
    });

    searchInput.addEventListener('focus', () => {
        if (searchInput.value.trim().length >= 2) fetchStreets(searchInput.value.trim());
    });

    document.addEventListener('click', e => {
        if (!searchInput.contains(e.target) && !suggestions.contains(e.target))
            suggestions.style.display = 'none';
    });

    async function fetchStreets(q) {
        try {
            const resp = await fetch(`/Admin/RiskEvents/Edit?handler=SearchStreets&q=${encodeURIComponent(q)}`);
            if (!resp.ok) return;
            const streets = await resp.json();
            renderSuggestions(streets);
        } catch { /* ignore */ }
    }

    function renderSuggestions(streets) {
        suggestions.innerHTML = '';
        if (!streets || streets.length === 0) {
            suggestions.style.display = 'none';
            return;
        }
        streets.forEach(s => {
            const label = s.name + (s.district ? ` — ${s.district}` : '');
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action py-2 small';
            btn.textContent = label;
            btn.addEventListener('click', () => {
                hiddenInput.value = s.id;
                searchInput.value = label;
                suggestions.style.display = 'none';
            });
            suggestions.appendChild(btn);
        });
        suggestions.style.display = 'block';
    }

    // Clear selection if user clears the search box
    searchInput.addEventListener('change', () => {
        if (!searchInput.value.trim()) hiddenInput.value = '';
    });
})();
</script>
}
